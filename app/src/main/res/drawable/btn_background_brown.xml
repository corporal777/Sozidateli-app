<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/action_button_register_background_disabled" />
            <corners android:radius="@dimen/chat_list_button_padding_left" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/action_button_register_background_disabled" />
            <corners android:radius="@dimen/chat_list_button_padding_left" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#C3996C" />
                    <corners android:radius="@dimen/chat_list_button_padding_left" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>


