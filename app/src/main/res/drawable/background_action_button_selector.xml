<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/action_button_disabled_background_color" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="@color/action_button_enabled_background_color" />
        </shape>
    </item>
</selector>