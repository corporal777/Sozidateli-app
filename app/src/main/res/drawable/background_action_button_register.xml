<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:width="1dp" android:color="@color/action_button_register_background_disabled" />
            <corners android:radius="@dimen/background_default_corners_radius" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/background_default_corners_radius" />
                    <solid android:color="@color/action_button_register_background_enabled" />
                </shape>
            </item>
            <item android:drawable="?attr/selectableItemBackground" />
        </layer-list>
    </item>
</selector>