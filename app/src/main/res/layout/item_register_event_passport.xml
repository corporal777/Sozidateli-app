<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout style="@style/EventRegistrationItemContainer">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textView"
            style="@style/Profile.Edit.InputEventRegisterTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Title" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilSerial"
            style="@style/Profile.Edit.PasswordNew"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="4dp"
            app:endIconMode="none"
            app:layout_constraintEnd_toStartOf="@id/tilNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView"
            app:layout_goneMarginTop="5dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSerial"
                style="@style/Profile.Edit.InputEventRegister"
                android:digits="0123456789"
                android:ems="5"
                android:hint="@string/event_register_serial"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="4"
                android:nextFocusDown="@id/etNumber" />
        </com.example.ui.views.CustomTextInputLayout>

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilNumber"
            style="@style/Profile.Edit.PasswordNew"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:endIconMode="none"
            app:layout_constraintBaseline_toBaselineOf="@+id/tilSerial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/tilSerial">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNumber"
                style="@style/Profile.Edit.InputEventRegister"
                android:digits="0123456789"
                android:ems="7"
                android:hint="@string/event_register_number"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="6"
                android:nextFocusDown="@id/etAgency" />
        </com.example.ui.views.CustomTextInputLayout>

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilAgency"
            style="@style/Profile.Edit.PasswordNew"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:endIconMode="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilSerial">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAgency"
                style="@style/Profile.Edit.InputEventRegister"
                android:hint="@string/event_register_agency"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:nextFocusDown="@id/etCode" />
        </com.example.ui.views.CustomTextInputLayout>


        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilCode"
            style="@style/Profile.Edit.PasswordNew"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="4dp"
            app:endIconMode="none"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/tilDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilAgency">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCode"
                style="@style/Profile.Edit.InputEventRegister"
                android:digits="0123456789"
                android:hint="@string/event_register_code"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1"
                android:singleLine="true" />
        </com.example.ui.views.CustomTextInputLayout>


        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilDate"
            style="@style/Profile.Edit.PasswordNew"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:endIconDrawable="@drawable/ic_calendar_new"
            app:endIconMode="custom"
            app:endIconTint="#C3996C"
            app:layout_constrainedWidth="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/tilCode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tilCode"
            app:layout_constraintTop_toBottomOf="@id/tilAgency">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                style="@style/Profile.Edit.InputEventRegister"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:hint="@string/event_register_date"
                android:maxLines="1"
                android:nextFocusDown="@id/etCode"
                android:singleLine="true" />
        </com.example.ui.views.CustomTextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
