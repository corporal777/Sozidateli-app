<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ChatList.Header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include
        android:id="@+id/etSearch"
        layout="@layout/view_search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        style="@style/ViewDivider.Horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnChats"
        style="@style/ChatList.Header.Button"
        android:layout_marginStart="13dp"
        android:layout_marginTop="8dp"
        android:text="@string/chat_list_contacts_and_chats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnRequests"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearch" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRequests"
        style="@style/ChatList.Header.Button"
        android:layout_marginEnd="13dp"
        android:text="@string/chat_list_chat_requests"
        app:layout_constraintBottom_toBottomOf="@+id/btnChats"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnChats"
        app:layout_constraintTop_toBottomOf="@+id/etSearch"
        app:layout_constraintTop_toTopOf="@+id/btnChats" />
</androidx.constraintlayout.widget.ConstraintLayout>