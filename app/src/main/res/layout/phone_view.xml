<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilCountryCodePhone"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:endIconMode="custom"
        app:errorEnabled="true"
        app:errorIconDrawable="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCountryCodePhone"
            style="@style/Profile.Edit.Input.SingleLine"
            android:paddingStart="115dp"
            android:hint="@string/profile_phone_mobile"
            android:inputType="phone" />

    </com.example.ui.views.CustomTextInputLayout>

    <com.hbb20.CountryCodePicker
        android:id="@+id/ccp"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        app:ccp_autoDetectCountry="false"
        app:ccp_autoFormatNumber="true"
        app:ccp_defaultLanguage="RUSSIAN"
        app:ccp_defaultNameCode="ru"
        app:ccp_showFlag="true"
        app:ccp_showNameCode="false"
        app:ccp_excludedCountries="kz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>