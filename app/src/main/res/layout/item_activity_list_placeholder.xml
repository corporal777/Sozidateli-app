<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_marginTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:orientation="vertical">

        <View
            android:layout_width="200dp"
            android:layout_height="15dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/ln_days" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="0dp"
            app:cardBackgroundColor="#14747480"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:layout_marginEnd="@dimen/margin_forty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="90dp"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_gravity="end"
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/margin_fifteen"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="0dp"
            app:cardBackgroundColor="#14747480"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:layout_marginEnd="@dimen/margin_forty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="90dp"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="@dimen/margin_seventy"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_gravity="end"
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/margin_fifteen"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>