<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/list_background"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvOrganizationLabel"
            fontPath="fonts/Roboto-Medium.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp"
            tools:ignore="MissingPrefix"
            tools:text="ООО Сбербанк - Организация, которая проводит мероприятие, может быть в 2 строчки, но дальше точки" />

        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:textSize="16sp"
            tools:text="Полный текст названия мероприятия в любое количество строк - рограммирование - новый язык поколения Зет: что с этим делать." />

        <LinearLayout
            android:id="@+id/llTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:orientation="horizontal">

            <TextView
                fontPath="fonts/Roboto-Bold.ttf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_event_time"
                android:textColor="@color/about_event_date"
                android:textSize="14sp"
                tools:ignore="MissingPrefix" />

            <TextView
                android:id="@+id/tvEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textColor="@color/about_event_date"
                android:textSize="14sp"
                tools:ignore="MissingPrefix"
                tools:text="14:00" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:orientation="horizontal">

            <TextView
                fontPath="fonts/Roboto-Bold.ttf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_event_date"
                android:textColor="@color/about_event_date"
                android:textSize="14sp"
                tools:ignore="MissingPrefix" />

            <TextView
                android:id="@+id/tvEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textColor="@color/about_event_date"
                android:textSize="14sp"
                tools:ignore="MissingPrefix"
                tools:text="4 сентярбя - 7 октября 2019 г." />
        </LinearLayout>

        <com.example.ui.views.UserSubscribeButton
            android:id="@+id/btnAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            app:subscribeAction="favorite" />
    </LinearLayout>
</FrameLayout>