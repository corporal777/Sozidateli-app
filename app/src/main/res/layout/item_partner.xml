<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:foreground="@drawable/custom_text_background_selectable"
        android:layout_height="wrap_content"
        android:paddingHorizontal="15dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvImage"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_margin="5dp"
            android:gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            android:elevation="0dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/event_item_action_border"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivPartnerImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_test" />

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_marginTop="25dp"
            android:id="@+id/tvPartnerName"
            fontPath="fonts/sf_pro_text.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:letterSpacing="-0.03"
            tools:text="Тинькофф"
            android:textColor="@color/vk_black"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/tvPartnerTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cvImage"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPartnerTitle"
            fontPath="fonts/sf_pro_text.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="25dp"
            android:letterSpacing="-0.03"
            android:maxLines="2"
            tools:text="Первый партнер проекта"
            android:textColor="#993C3C43"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cvImage"
            app:layout_constraintTop_toBottomOf="@id/tvPartnerName" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
