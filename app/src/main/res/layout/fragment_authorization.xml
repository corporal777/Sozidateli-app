<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_auth_very_small"
        android:fitsSystemWindows="true">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/svContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="25dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/top_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.09" />


                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_logo_text_height"
                    android:src="@drawable/ic_app_logo_main"
                    app:layout_constraintTop_toBottomOf="@id/top_line" />

                <TextView
                    android:id="@+id/tvPagerTitle"
                    style="@style/AuthPagerTextViewTitleHeavyStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_horizontal"
                    android:lineSpacingExtra="-3dp"
                    android:text="@string/auth_pager_title_text"
                    android:textSize="@dimen/auth_pager_title_text_size"
                    app:layout_constraintBottom_toTopOf="@id/storiesPager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivLogo"
                    app:layout_constraintVertical_bias="0.95"
                    app:layout_constraintVertical_chainStyle="spread_inside"
                    tools:layout_editor_absoluteX="0dp" />


                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/storiesPager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@id/tab_dots"
                    app:layout_constraintVertical_chainStyle="spread_inside" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="50dp"
                    android:background="@null"
                    app:layout_constraintBottom_toTopOf="@id/btnRegister"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tabBackground="@drawable/tab_stories_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabPaddingEnd="10dp"
                    app:tabPaddingStart="10dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRegister"
                    style="@style/BtnBrownStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:minHeight="@dimen/auth_buttons_min_height"
                    android:text="@string/auth_action_register"
                    android:textSize="@dimen/auth_buttons_text_size"
                    app:layout_constraintBottom_toTopOf="@+id/btnLogin"
                    app:layout_constraintVertical_chainStyle="spread_inside" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogin"
                    style="@style/BtnBrownCancelStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:minHeight="@dimen/auth_buttons_min_height"
                    android:text="@string/auth_label_login"
                    android:textSize="@dimen/auth_buttons_text_size"
                    app:layout_constraintBottom_toTopOf="@id/tvLogin"
                    app:layout_constraintVertical_chainStyle="spread_inside" />

                <TextView
                    android:id="@+id/tvLogin"
                    fontPath="fonts/sf_pro_display.OTF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="15dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="@string/or_auth_in_one_click"
                    android:textColor="#E6FFFFFF"
                    android:textSize="@dimen/auth_buttons_title_text_size"
                    app:layout_constraintBottom_toTopOf="@id/btn_login_vk" />


                <com.example.ui.views.loading.CustomLoadingButton
                    android:id="@+id/btn_login_vk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    app:buttonBackground="@drawable/btn_background_vk"
                    app:buttonDrawable="@drawable/ic_vk_logo"
                    app:buttonMinHeight="@dimen/auth_buttons_min_height"
                    app:buttonText="@string/auth_label_login_with_vk"
                    app:buttonTextSize="@dimen/auth_buttons_text_size"
                    app:layout_constraintBottom_toTopOf="@id/btn_login_gos" />

                <com.example.ui.views.loading.CustomLoadingButton
                    android:id="@+id/btn_login_gos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:buttonBackground="@drawable/btn_background_white"
                    app:buttonDrawable="@drawable/ic_gos_uslugi_logo"
                    app:buttonMinHeight="@dimen/auth_buttons_min_height"
                    app:buttonText="@string/auth_label_login_with_gos"
                    app:buttonTextColor="@color/gos_uslugi_button_text_color"
                    app:buttonTextSize="@dimen/auth_buttons_text_size"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>


</layout>


