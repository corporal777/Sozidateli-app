<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view_main_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@id/btnSave"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="15dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/photo_title"
                    style="@style/Profile.Edit.TextViewTitleThin"
                    android:text="@string/profile_photo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.example.ui.views.CustomAvatarView
                    android:id="@+id/ivAvatar"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/content_description_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/photo_title" />


                <TextView
                    android:id="@+id/tvEditImage"
                    style="@style/ClickableTextView"
                    android:layout_marginStart="20dp"
                    android:text="@string/profile_add_photo"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                    app:layout_constraintStart_toEndOf="@id/ivAvatar"
                    app:layout_constraintTop_toTopOf="@id/ivAvatar" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/birthday_title"
                    style="@style/Profile.Edit.TextViewTitleThin"
                    android:layout_marginTop="25dp"
                    android:text="@string/profile_birthday"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivAvatar" />

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/tilBirthday"
                    style="@style/TextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="5dp"
                    app:endIconDrawable="@drawable/ic_calendar_new"
                    app:endIconMode="custom"
                    app:endIconTint="#C3996C"
                    app:layout_constraintTop_toBottomOf="@id/birthday_title">

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/etBirthday"
                        style="@style/TextInputAutoTextStyle"
                        android:hint="@string/profile_birthday" />
                </com.example.ui.views.CustomTextInputLayout>


                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/sc_no_birthday"
                    style="@style/Profile.Edit.Switch"
                    android:layout_width="wrap_content"
                    android:text="@string/profile_show_in_profile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilBirthday" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/gender_title"
                    style="@style/Profile.Edit.TextViewTitleThin"
                    android:layout_marginTop="15dp"
                    android:text="@string/profile_gender"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sc_no_birthday" />

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/tilGender"
                    style="@style/TextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="5dp"
                    app:endIconDrawable="@drawable/drawable_drop_down_switch"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="#C3996C"
                    app:layout_constraintTop_toBottomOf="@id/gender_title">

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/etGender"
                        style="@style/TextInputAutoTextStyle"
                        android:backgroundTint="#33C3996C"
                        android:hint="@string/profile_gender" />
                </com.example.ui.views.CustomTextInputLayout>

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/sc_no_gender"
                    android:layout_width="wrap_content"
                    style="@style/Profile.Edit.Switch"
                    android:text="@string/profile_show_in_profile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilGender" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/region_title"
                    style="@style/Profile.Edit.TextViewTitleThin"
                    android:layout_marginTop="15dp"
                    android:layout_width="match_parent"
                    android:text="@string/profile_city"
                    app:layout_constraintTop_toBottomOf="@id/sc_no_gender" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_region"
                    android:freezesText="true"
                    style="@style/ProfileData.TextView"
                    android:layout_width="match_parent"
                    android:layout_marginTop="5dp"
                    app:drawableEndCompat="@drawable/ic_arrow_right_brown"
                    android:hint="@string/search_filter_region"
                    app:layout_constraintTop_toBottomOf="@id/region_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_city"
                    android:freezesText="true"
                    style="@style/ProfileData.TextView"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    app:drawableEndCompat="@drawable/ic_arrow_right_brown"
                    android:hint="@string/profile_locality"
                    app:layout_constraintTop_toBottomOf="@id/tv_region" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/sc_no_address"
                    android:layout_width="wrap_content"
                    style="@style/Profile.Edit.Switch"
                    android:text="@string/profile_show_in_profile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_city" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/phone_title"
                    style="@style/Profile.Edit.TextViewTitleThin"
                    android:layout_marginTop="15dp"
                    android:text="@string/profile_phone_mobile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sc_no_address" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_mobile_phone"
                    android:freezesText="true"
                    style="@style/ProfileData.TextView"
                    android:layout_width="match_parent"
                    android:layout_marginTop="5dp"
                    app:drawableEndCompat="@drawable/ic_arrow_right_brown"
                    android:hint="@string/profile_phone_mobile"
                    app:layout_constraintTop_toBottomOf="@id/phone_title" />


                <TextView
                    android:id="@+id/tvEditPhone"
                    style="@style/ClickableTextView"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/edit_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_mobile_phone" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <!--                <androidx.recyclerview.widget.RecyclerView-->
        <!--                    android:id="@+id/recyclerView"-->
        <!--                    android:layout_width="match_parent"-->
        <!--                    android:layout_height="0dp"-->
        <!--                    android:layout_marginBottom="10dp"-->
        <!--                    android:clipToPadding="false"-->
        <!--                    android:descendantFocusability="beforeDescendants"-->
        <!--                    android:paddingBottom="20dp"-->
        <!--                    app:layout_constraintBottom_toTopOf="@+id/btnSave"-->
        <!--                    app:layout_constraintEnd_toEndOf="parent"-->
        <!--                    app:layout_constraintStart_toStartOf="parent"-->
        <!--                    app:layout_constraintTop_toTopOf="parent"-->
        <!--                    tools:itemCount="1"-->
        <!--                    tools:listitem="@layout/item_edit_main_info" />-->

        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginVertical="10dp"
            app:buttonMinHeight="@dimen/common_button_min_height"
            app:buttonText="@string/auth_action_continue"
            app:buttonTextSize="@dimen/common_button_text_size"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
