<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/main_background"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvTime"
        fontPath="fonts/Roboto-Light.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/profile_padding_start"
        android:layout_marginTop="20dp"
        android:textColor="@color/text_title"
        android:textSize="18sp"
        tools:ignore="MissingPrefix"
        tools:text="9:00-10:00" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/profile_padding_start"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="@dimen/profile_padding_start"
        android:textColor="@color/text_title"
        android:textSize="18sp"
        tools:text="Прикладная че то там сессия" />

    <TextView
        android:id="@+id/tvDescription"
        fontPath="fonts/Roboto-Light.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/profile_padding_start"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/profile_padding_start"
        android:maxLength="200"
        android:textColor="@color/text_title"
        android:textSize="16sp"
        tools:ignore="MissingPrefix"
        tools:text="Прикладная че то там сессия" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReadMore"
        fontPath="fonts/Roboto-Bold.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/background_button_underline"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/show_more"
        android:textAllCaps="false"
        android:textColor="@color/text_title"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvLocation"
        fontPath="fonts/Roboto-Bold.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/profile_padding_start"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="@dimen/profile_padding_start"
        android:drawableStart="@drawable/ic_location_dark"
        android:drawablePadding="10dp"
        android:textAllCaps="true"
        android:textColor="@color/text_title"
        android:textSize="12sp"
        tools:ignore="MissingPrefix"
        tools:text="Павильон 1" />
</LinearLayout>