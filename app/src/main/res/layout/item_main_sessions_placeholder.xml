<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:elevation="0dp"
        app:cardBackgroundColor="#F6F6F6"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_duration="1500">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_session"
                android:layout_width="match_parent"
                android:layout_height="@dimen/current_session_item_height">

                <View
                    android:id="@+id/vIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginEnd="@dimen/margin_fifteen"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    app:layout_constraintBottom_toTopOf="@id/tvType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/tvType"
                    android:layout_width="0dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="@dimen/margin_fifteen"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvLocation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvName" />

                <View
                    android:id="@+id/tvLocation"
                    android:layout_width="0dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="@dimen/margin_fifteen"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvType" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.facebook.shimmer.ShimmerFrameLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="10dp"
        android:elevation="0dp"
        app:cardBackgroundColor="#F6F6F6"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp" />

</LinearLayout>
