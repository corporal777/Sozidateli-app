<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/event_image_height_new"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_test"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/eventImageShadow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/event_image_shadow_height_new"
            android:background="@drawable/event_detail_image_gradient"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo" />


        <LinearLayout
            android:id="@+id/cl_text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            app:layout_constraintTop_toTopOf="@id/eventImageShadow">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEventLocation"
                fontPath="fonts/sf_pro_text_semibold.ttf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="Краснодарский край, г. Сочи" />

            <TextView
                android:id="@+id/tvEventName"
                fontPath="fonts/sf_pro_text_bold.ttf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="@dimen/event_detail_name_text_size"
                tools:text="Разработка и подача проекта: от идеи до гранта, включая план и анализ." />

        </LinearLayout>


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEventDate"
            fontPath="fonts/sf_pro_text.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/hint_gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_text_title"
            tools:text="Заявки принимаются до 7 июля" />

        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnEventAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            android:importantForAccessibility="no"
            app:buttonBackground="@drawable/btn_background_green"
            app:buttonMinHeight="@dimen/auth_buttons_min_height"
            app:buttonText="@string/go_to_event"
            app:buttonTextColor="@color/white"
            app:buttonTextSize="@dimen/auth_buttons_text_size"
            app:layout_constraintTop_toBottomOf="@+id/tvEventDate" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCancelRegister"
            fontPath="fonts/sf_pro_text_medium.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:letterSpacing="-0.02"
            tools:text="@string/change_decision"
            android:textColor="#C3996C"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEventAction" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEventDescription"
            fontPath="fonts/sf_pro_text.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="5"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvCancelRegister"
            tools:text="Мастер-класс по разработке социального проекта и подготовке заявки на грант: обучающее мероприятие для активистов и НКО, желающих реализовать социальные инициативы. Участники изучат основы проектного менеджмента, методы..." />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvShowMore"
            fontPath="fonts/sf_pro_text_semibold.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/btn_background_text"
            android:drawableStart="@drawable/ic_about_session"
            android:drawablePadding="10dp"
            android:text="Подробнее"
            android:textColor="@color/main_brown_color_new"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEventDescription" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
