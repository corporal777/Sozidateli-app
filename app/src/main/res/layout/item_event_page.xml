<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_highlight"
    android:orientation="vertical"
    android:theme="@style/ViewBackgroundWhite">

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/ic_keyboard_arrow_right"
        android:drawablePadding="8dp"
        android:paddingStart="@dimen/profile_padding_start"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/profile_padding_start"
        android:paddingBottom="16dp"
        android:textSize="16sp"
        tools:text="@tools:sample/lorem" />

    <View style="@style/ViewDivider.Horizontal" />

    <FrameLayout
        android:id="@+id/flAdditionalBottomPadding"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/main_background"
        android:visibility="gone">

        <View
            style="@style/ViewDivider.Horizontal"
            android:layout_gravity="bottom" />
    </FrameLayout>

</LinearLayout>