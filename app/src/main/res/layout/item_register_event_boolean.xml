<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        style="@style/EventRegistrationItemContainer"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textView"
            fontPath="fonts/sf_pro_display_regular.OTF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:layout_marginBottom="6dp"
            android:letterSpacing="-0.01"
            android:textColor="@color/profile_data_text_hint"
            android:textSize="14sp"
            tools:text="Title" />

        <include
            android:id="@+id/include"
            layout="@layout/item_checkbox" />

        <TextView
            android:id="@+id/tvDescription"
            fontPath="fonts/sf_pro_text.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:letterSpacing="-0.01"
            android:paddingStart="7dp"
            android:paddingEnd="0dp"
            android:textColor="@color/hint_gray"
            android:textSize="15sp"
            tools:ignore="MissingPrefix"
            tools:text="Description text" />

        <View
            style="@style/ViewDivider.Form"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginEnd="@dimen/margin_horizontal_default" />
    </LinearLayout>
</layout>
