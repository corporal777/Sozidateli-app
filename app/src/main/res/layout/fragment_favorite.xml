<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTabEvents"
            style="@style/CustomTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:background="@drawable/background_custom_tab_left_selector"
            android:text="@string/favorites_events"
            app:layout_constraintEnd_toStartOf="@+id/btnTabOrganizations"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTabOrganizations"
            style="@style/CustomTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/background_custom_tab_center_selector"
            android:text="@string/favorites_organizations"
            app:layout_constraintBaseline_toBaselineOf="@+id/btnTabEvents"
            app:layout_constraintEnd_toStartOf="@+id/btnTabUsers"
            app:layout_constraintStart_toEndOf="@+id/btnTabEvents" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTabUsers"
            style="@style/CustomTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:background="@drawable/background_custom_tab_right_selector"
            android:text="@string/favorites_users"
            app:layout_constraintBaseline_toBaselineOf="@+id/btnTabOrganizations"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnTabOrganizations" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp" />
</LinearLayout>