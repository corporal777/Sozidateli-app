<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:visibility="invisible"
    android:id="@+id/main_content"
    tools:ignore="MissingPrefix"
    android:layout_height="match_parent">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <androidx.constraintlayout.widget.ConstraintLayout
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:id="@+id/imageBlock"
                android:layout_height="wrap_content"
                android:background="@color/vk_black"
                android:paddingBottom="20dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivLogo"
                    android:adjustViewBounds="true"
                    android:layout_width="match_parent"
                    android:layout_height="450dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_test"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@drawable/background_gradient_down"
                    app:layout_constraintBottom_toBottomOf="@id/ivLogo" />

                <TextView
                    android:id="@+id/tvEventTitle"
                    fontPath="fonts/sf_pro_display_bold.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="10dp"
                    android:text="Конференция лидеров проектов победителей конкурсов"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    app:layout_constraintBottom_toTopOf="@id/tvDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingPrefix" />

                <TextView
                    android:id="@+id/tvDate"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="29.02.2022 – 30.04.2022"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toTopOf="@id/tvLocation"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingPrefix" />


                <TextView
                    android:id="@+id/tvLocation"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:text="Краснодарский край, г. Сочи"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingPrefix" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/actionBlock"
                app:layout_constraintBottom_toTopOf="@id/organization_block"
                app:layout_constraintTop_toBottomOf="@id/imageBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/vk_black">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEventAction"
                    fontPath="fonts/sf_pro_text_bold.ttf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/custom_btn_white_selectable"
                    android:letterSpacing="-0.02"
                    android:text="@string/go_to_event"
                    android:textAllCaps="false"
                    android:textColor="@color/event_item_action_text"
                    android:textSize="17sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/tvRequestsDate"
                    fontPath="fonts/sf_pro_text_medium.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:text="Заявки принимаются до 7 июля"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toTopOf="@id/tvDescription"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnEventAction"
                    tools:ignore="MissingPrefix" />


                <TextView
                    android:id="@+id/tvDescription"
                    fontPath="fonts/sf_pro_text.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="15dp"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvRequestsDate"
                    tools:ignore="MissingPrefix" />

                <LinearLayout
                    android:id="@+id/address_ln"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription">

                    <TextView
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Адрес:"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />


                    <TextView
                        android:id="@+id/tvAddress"
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="г. Тула, Ленина 15"
                        android:textColor="#C3996C"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/phone_ln"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/address_ln">

                    <TextView
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Телефон:"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />


                    <TextView
                        android:id="@+id/tvPhone"
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="+7 (495) 111 -11- 22"
                        android:textColor="#C3996C"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/email_ln"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/phone_ln">

                    <TextView
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="E-mail:"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />


                    <TextView
                        android:id="@+id/tvEmail"
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="love@houseofapps.ru"
                        android:textColor="#C3996C"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/link_ln"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/email_ln">

                    <TextView
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Сайт:"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />


                    <TextView
                        android:id="@+id/tvLink"
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="leader-russia.ru"
                        android:textColor="#C3996C"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/network_ln"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/link_ln">

                    <TextView
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Соцсеть:"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />


                    <TextView
                        android:id="@+id/tvSocialNetwork"
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="vk.com/leader"
                        android:textColor="#C3996C"
                        android:textSize="15sp"
                        tools:ignore="MissingPrefix" />

                </LinearLayout>

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrier"
                    app:constraint_referenced_ids="network_ln"
                    app:barrierDirection="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/organization_block"
                app:layout_constraintTop_toBottomOf="@id/actionBlock"
                android:layout_width="match_parent"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content">

                <TextView
                    app:layout_constraintBottom_toTopOf="@id/organization_cl"
                    android:letterSpacing="0.02"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2sp"
                    android:id="@+id/tvHeader"
                    fontPath="fonts/sf_pro_display_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    android:text="Мероприятие проводит"
                    android:textColor="@color/vk_black"
                    android:textSize="22sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <androidx.constraintlayout.widget.ConstraintLayout
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_width="match_parent"
                    android:id="@+id/organization_cl"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="10dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tvHeader">


                    <LinearLayout
                        android:gravity="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:background="@drawable/background_image_with_stroke"
                        android:layout_marginStart="15dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/cv_photo"
                        android:layout_width="90dp"
                        android:layout_height="90dp">

                        <ImageView
                            android:scaleType="centerCrop"
                            android:id="@+id/ivOrganizationLogo"
                            android:layout_width="75dp"
                            android:layout_height="75dp"
                            android:src="@drawable/img_test" />
                    </LinearLayout>


                    <TextView
                        android:letterSpacing="-0.02"
                        android:maxLines="2"
                        android:id="@+id/tvOrganizationLabel"
                        fontPath="fonts/sf_pro_display_semibold.ttf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="10dp"
                        android:ellipsize="end"
                        android:text="ООО Сбербанк"
                        android:textSize="17sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cv_photo"
                        app:layout_constraintTop_toTopOf="parent" />


                    <com.example.ui.views.UserSubscribeButton
                        android:layout_marginStart="7dp"
                        android:id="@+id/btnActionFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cv_photo"
                        app:subscribeAction="favorite" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/organization_block"
                    android:id="@+id/speakersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_speaker_new" />

            <TextView
                android:id="@+id/tvProgramTitle"
                fontPath="fonts/sf_pro_display_bold.ttf"
                android:layout_width="0dp"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:letterSpacing="0.02"
                android:text="@string/event_program"
                android:textColor="@color/vk_black"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/speakersList" />


            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvProgramTitle"
                app:chipSpacingHorizontal="5dp"
                app:lineSpacing="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/chip_group"
                android:id="@+id/otherContentList"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="50dp"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="1"
                tools:listitem="@layout/item_lecture" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

<!--    <androidx.recyclerview.widget.RecyclerView-->
<!--        android:id="@+id/recyclerView"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:clipToPadding="false"-->
<!--        android:paddingBottom="50dp"-->
<!--        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"-->
<!--        tools:itemCount="1"-->
<!--        tools:listitem="@layout/item_event_detail_image_block" />-->

    <!--    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout-->
    <!--        android:id="@+id/swipeToRefresh"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content">-->

    <!--        -->


    <!--    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>-->

    <com.example.ui.views.toolbar.widget.TransparentToolBar
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/aboutEventToolbar"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:background="@null"
                app:contentInsetStart="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/toolbar_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/custom_toolbar_btn_background_selectable"
                        android:padding="10dp"
                        android:src="@drawable/ic_back_white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddToCalendar"
                        fontPath="fonts/sf_pro_text_semibold.ttf"
                        android:layout_width="145dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/custom_btn_add_to_calendar_background"
                        android:minHeight="@dimen/auth_button_min_height"
                        android:text="@string/add_to_calendar"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/iv_share" />


                    <ImageView
                        android:id="@+id/iv_share"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="5dp"
                        android:background="@drawable/custom_toolbar_btn_background_selectable"
                        android:padding="8dp"
                        android:src="@drawable/ic_share_white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.Toolbar>

            <View
                android:id="@+id/shadow"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#C6C6C8"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.example.ui.views.toolbar.widget.TransparentToolBar>


</androidx.coordinatorlayout.widget.CoordinatorLayout>