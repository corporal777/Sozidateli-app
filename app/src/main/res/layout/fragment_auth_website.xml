<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_auth_very_small"
        android:fitsSystemWindows="true">

        <ScrollView
            android:id="@+id/svContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_logo_text_height"
                    android:src="@drawable/ic_app_logo_main"
                    app:layout_constraintBottom_toTopOf="@id/top_guideLine"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/top_guideLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.3" />


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="30dp"
                    android:layout_marginTop="20dp"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/top_guideLine"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvJoinMessage"
                        fontPath="fonts/sf_pro_display_semibold.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/auth_web_title_login"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="MissingPrefix" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvAuthInfo"
                        fontPath="fonts/sf_pro_display_semibold.ttf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Информация о входе:"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mdtp_datepicker_year_selection_text_size"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvJoinMessage"
                        tools:ignore="MissingPrefix" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDevice"
                        fontPath="fonts/sf_pro_display_regular.OTF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mdtp_datepicker_year_selection_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAuthInfo"
                        tools:ignore="MissingPrefix"
                        tools:text="Chrome (macOS Catalina)" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvIPAddress"
                        fontPath="fonts/sf_pro_display_regular.OTF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mdtp_datepicker_year_selection_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvDevice"
                        tools:ignore="MissingPrefix"
                        tools:text="94.25.169.121" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTime"
                        fontPath="fonts/sf_pro_display_regular.OTF"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mdtp_datepicker_year_selection_text_size"
                        app:layout_constraintBottom_toTopOf="@id/btnConfirm"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvIPAddress"
                        tools:ignore="MissingPrefix"
                        tools:text="18:16 (мск)" />


                    <com.example.ui.views.loading.CustomLoadingButton
                        android:id="@+id/btnConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="20dp"
                        app:buttonMinHeight="@dimen/common_button_min_height"
                        app:buttonText="@string/confirm"
                        app:buttonTextSize="@dimen/common_button_text_size"
                        app:layout_constraintBottom_toTopOf="@id/btnDoNotConfirm"
                        app:layout_constraintTop_toBottomOf="@id/tvTime" />


                    <com.example.ui.views.loading.CustomLoadingButton
                        android:id="@+id/btnDoNotConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="30dp"
                        app:buttonMinHeight="@dimen/common_button_min_height"
                        app:buttonBackground="@drawable/btn_background_corners_brown"
                        app:buttonText="@string/do_not_confirm"
                        app:buttonTextSize="@dimen/common_button_text_size"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>

