<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            app:endIconDrawable="@drawable/ic_filter"
            app:endIconMode="custom"
            app:endIconTint="@android:color/transparent"
            app:endIconTintMode="screen"
            app:errorEnabled="false"
            app:errorIconDrawable="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appCompatTextView2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/search_input_hint"
                android:imeOptions="actionSearch"
                android:inputType="textFilter" />
        </com.example.ui.views.CustomTextInputLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            style="@style/AppTheme.Tabs"
            android:layout_width="match_parent"
            app:tabMode="fixed" />
    </LinearLayout>

    <View
        android:id="@+id/tabsDivider"
        style="@style/ViewDivider.Horizontal" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>