<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?dialogPreferredPadding"
    android:paddingTop="16dp"
    android:paddingEnd="?dialogPreferredPadding">

    <TextView
        android:id="@+id/tvCodeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        tools:text="@string/status_profile_status_code_set" />

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilCode"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:endIconMode="custom"
        app:errorIconDrawable="@null">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCode"
            style="@style/Profile.Edit.Input.SingleLine"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:hint="@string/status_profile_status_code_hint"
            android:inputType="number" />
    </com.example.ui.views.CustomTextInputLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDoNotReceiveCode"
        fontPath="fonts/Roboto-Bold.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/background_button_underline"
        android:minWidth="0dp"
        android:text="@string/status_profile_status_code_do_not_receive"
        android:textAllCaps="false"
        android:textColor="@color/text_title"
        android:textSize="15sp" />
</LinearLayout>