<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_user_item">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvImageName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_organization_logo"
        android:gravity="center"
        android:maxLines="3"
        android:padding="4dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
        app:layout_constraintEnd_toEndOf="@+id/ivLogo"
        app:layout_constraintStart_toStartOf="@+id/ivLogo"
        app:layout_constraintTop_toTopOf="@+id/ivLogo"
        tools:ignore="ContentDescription"
        tools:text="@tools:sample/full_names" />

    <ImageView
        android:id="@+id/ivLogo"
        style="@style/UserItem.Avatar"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:background="@drawable/background_organization_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription"
        tools:src="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tvEventName"
        style="@style/UserItem.Name"
        android:lines="3"
        app:layout_constraintBottom_toTopOf="@+id/tvEventDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivLogo"
        app:layout_constraintTop_toTopOf="@+id/ivLogo"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="17dp"
        tools:text="@tools:sample/full_names" />

    <TextView
        android:id="@+id/tvEventDate"
        fontPath="fonts/Roboto-Light.ttf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
        app:layout_constraintEnd_toEndOf="@+id/tvEventName"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/tvEventName"
        app:layout_constraintTop_toBottomOf="@+id/tvEventName"
        tools:ignore="MissingPrefix"
        tools:text="5.02.19 - 30.06.19" />

    <View
        android:id="@+id/divider"
        style="@style/ViewDivider.Horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>