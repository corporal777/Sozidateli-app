<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.ui.views.AutoPlaceholderRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:hideOnEmpty="true"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:placeholder="@+id/placeholder" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivPlaceholderImage"
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:layout_constraintBottom_toTopOf="@+id/tvPlaceholderMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_neutral_face" />

        <!--suppress AndroidUnknownAttribute -->
        <TextView
            android:id="@+id/tvPlaceholderMessage"
            fontPath="fonts/Robotoans-Light.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:textColor="@color/auth_email_color"
            android:textSize="32sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivPlaceholderImage"
            tools:ignore="MissingPrefix"
            tools:text="У вас нет событий  добавьте их из списка " />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>