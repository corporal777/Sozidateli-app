<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title_work_experience"
            fontPath="fonts/sf_pro_text_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="20dp"
            android:text="@string/user_profile_experience"
            android:textColor="@color/profile_data_text_hint"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/ln_work_experience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:orientation="vertical">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_work_date"
                style="@style/EventRegistration.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/profile_social_date" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWorkDate"
                style="@style/EventRegistration.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="25.10.2003" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_organization"
                style="@style/EventRegistration.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/profile_social_project_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrganization"
                style="@style/EventRegistration.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/user_profile_additional_hint" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_position"
                style="@style/EventRegistration.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/profile_social_project_role" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPosition"
                style="@style/EventRegistration.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/user_profile_additional_hint" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/divider_darker" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_no_work_experience"
            style="@style/EventRegistration.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="8dp"
            android:text="@string/user_profile_additional_hint"
            android:textColor="@color/red_new"
            android:visibility="gone"
            tools:visibility="visible" />


    </LinearLayout>


</layout>