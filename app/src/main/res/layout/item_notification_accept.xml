<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:paddingBottom="16dp"
    tools:background="@color/notification_center_notification_read">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Notification.Title"
        fontPath="fonts/Roboto-Medium.ttf"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingPrefix"
        tools:text="@string/notifications_simple_title" />

    <TextView
        android:id="@+id/tvDate"
        style="@style/Notification.Date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        tools:ignore="MissingPrefix"
        tools:text="@tools:sample/date/ddmmyy" />

    <TextView
        android:id="@+id/tvMessage"
        style="@style/Notification.Message"
        android:ellipsize="end"
        android:maxLength="200"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDate"
        app:layout_constraintVertical_bias="0.0"
        app:layout_goneMarginBottom="10dp"
        tools:ignore="MissingPrefix"
        tools:text="@tools:sample/lorem/random"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReadMore"
        style="@style/Notification.ActionButton"
        fontPath="fonts/Roboto-Medium.ttf"
        android:layout_marginTop="10dp"
        android:drawableEnd="@drawable/ic_notification_read_more"
        android:text="@string/notifications_read_more"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMessage"
        tools:visibility="gone" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAccept"
        style="@style/Notification.ActionButton"
        fontPath="fonts/Roboto-Bold.ttf"
        android:layout_marginTop="6dp"
        android:text="@string/notifications_accept"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnCancel"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnReadMore"
        app:layout_goneMarginTop="10dp"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancel"
        style="@style/Notification.ActionButton"
        fontPath="fonts/Roboto-Bold.ttf"
        android:text="@string/notifications_cancel"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/btnAccept"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.374"
        app:layout_constraintStart_toEndOf="@+id/btnAccept"
        app:layout_constraintTop_toTopOf="@+id/btnAccept"
        app:layout_constraintVertical_bias="0.0"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvAcceptState"
        style="@style/Notification.Action"
        fontPath="fonts/Roboto-Medium.ttf"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnReadMore"
        app:layout_goneMarginBottom="10dp"
        app:layout_goneMarginTop="16dp"
        tools:ignore="MissingPrefix"
        tools:text="@string/notifications_state_accepted"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnChangeDecision"
        style="@style/Notification.ActionButton"
        fontPath="fonts/Roboto-Bold.ttf"
        android:text="@string/notifications_change_decision"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvAcceptState"
        app:layout_constraintStart_toEndOf="@+id/tvAcceptState"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>