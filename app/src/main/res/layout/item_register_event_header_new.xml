<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vk_black">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/event_image_height_new"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_test"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/background_gradient_down"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/top_guideLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="360dp" />


        <TextView
            android:id="@+id/tvFormLabel"
            fontPath="fonts/sf_pro_display_bold.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:textColor="@color/white"
            android:textSize="19sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_guideLine"
            tools:ignore="MissingPrefix"
            tools:text="Анкета козоводов России, а также какой-то длинный заголовок анкеты" />


        <TextView
            android:id="@+id/tvFormDescription"
            fontPath="fonts/sf_pro_text.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:letterSpacing="-0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFormLabel"
            tools:ignore="MissingPrefix"
            tools:text="Развитие сельского хозяйства для личных подсобных хозяйств и крестьянско-фермерских хозяйств" />

        <TextView
            android:id="@+id/tvEventDate"
            fontPath="fonts/sf_pro_text_semibold.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:letterSpacing="-0.01"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFormDescription"
            tools:ignore="MissingPrefix"
            tools:text="29.02.2022 – 30.04.2022" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>