<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:paddingStart="@dimen/profile_padding_start"
    android:paddingTop="15dp"
    android:paddingEnd="@dimen/profile_padding_start"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/tvOrganizationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        fontPath="fonts/OpenSans-Bold.ttf"
        app:layout_constraintEnd_toStartOf="@id/ivArrow"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Fond temp" />

    <TextView
        android:id="@+id/tvEventName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@id/ivArrow"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/tvOrganizationName"
        tools:text="Российский инвестиционный форум" />

    <TextView
        android:id="@+id/tvEventDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        fontPath="fonts/OpenSans-Light.ttf"
        app:layout_constraintEnd_toStartOf="@id/ivArrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEventName"
        tools:text="5.02 - 30.09.18" />

    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_keyboard_arrow_right"
        app:layout_constraintBottom_toTopOf="@id/btnEvent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <Button
        android:id="@+id/btnEvent"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/background_corners"
        android:text="@string/search_event_involve"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:theme="@style/ViewBackgroundAccent"
        app:layout_constraintTop_toBottomOf="@id/tvEventDate" />

</androidx.constraintlayout.widget.ConstraintLayout>