<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/btnConfirm"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/ln_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    fontPath="fonts/sf_pro_display_semibold.ttf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:letterSpacing="-0.01"
                    android:text="@string/confirm_phone_number_by_code"
                    android:textColor="@color/auth_title_text"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_mobile_phone"
                    fontPath="fonts/sf_pro_display_bold.ttf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:letterSpacing="0.25"
                    android:textColor="@color/chat_list_date"
                    android:textSize="20sp"
                    tools:text="+7 910 123 22 22" />

                <TextView
                    fontPath="fonts/sf_pro_display.OTF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:letterSpacing="-0.01"
                    android:text="@string/enter_last_four_numbers_of_call_number"
                    android:textColor="@color/black"
                    android:textSize="17sp" />


                <com.example.ui.views.codeView.CodeConfirmationView
                    android:id="@+id/phone_code_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_code_error"
                    fontPath="fonts/sf_pro_display.OTF"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:text="@string/auth_error_code_new"
                    android:textColor="@color/title_text_error_red"
                    android:textSize="17sp" />


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginBottom="10dp"
            app:buttonBackground="@drawable/custom_btn_brown_selectable"
            app:buttonMinHeight="@dimen/auth_button_min_height"
            app:buttonText="@string/confirm"
            app:layout_constraintBottom_toTopOf="@id/btnCallAgain" />

        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnCallAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_fifteen"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            app:buttonBackground="@drawable/custom_btn_repeat_code_selectable"
            app:buttonMinHeight="@dimen/auth_button_min_height"
            app:buttonText="@string/send_call_again"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>