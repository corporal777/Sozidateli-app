<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/main_background"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQuestionTitle"
                fontPath="fonts/sf_pro_display_bold.ttf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:letterSpacing="-0.01"
                android:textColor="@color/black"
                android:textSize="24sp"
                tools:text="Как изменить ФИО?" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQuestionAnswer"
                fontPath="fonts/sf_pro_display.OTF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:gravity="start"
                android:layout_marginTop="20dp"
                android:letterSpacing="-0.01"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:includeFontPadding="false" />

            <androidx.appcompat.widget.AppCompatTextView
                fontPath="fonts/sf_pro_display_bold.ttf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="35dp"
                android:text="@string/do_you_need_help_or_information"
                android:textColor="@color/profile_title_text"
                android:textSize="17sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSendQuestion"
                style="@style/BtnGrayWriteStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/margin_horizontal_default"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:minHeight="35dp"
                android:paddingHorizontal="30dp"
                android:text="@string/give_me_question_title"
                android:textColor="#BE9B72" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</layout>