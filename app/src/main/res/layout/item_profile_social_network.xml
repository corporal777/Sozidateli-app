<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="0dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="@dimen/margin_horizontal_default">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/background_input_normal">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSn"
            style="@style/Profile.Edit.Input.SingleLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:hint="@string/user_profile_social_networks_hint"
            android:imeOptions="actionSearch"
            android:inputType="textWebEditText"
            app:layout_constraintEnd_toStartOf="@+id/btnDelete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description_delete"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/scNetwork"
        style="@style/Profile.Edit.Switch"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@+id/layField"
        app:layout_constraintTop_toBottomOf="@+id/layField"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/profile_show_in_profile"
        tools:checked="true" />

</androidx.constraintlayout.widget.ConstraintLayout>
