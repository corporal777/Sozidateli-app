<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/profile_padding_start"
    android:layout_marginEnd="@dimen/profile_padding_start"
    android:layout_marginBottom="16dp"
    android:background="@drawable/background_event"
    android:minHeight="262dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:transitionName="logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@android:color/black"
            tools:ignore="ContentDescription" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvOrganizationLabel"
            fontPath="fonts/Roboto-Bold.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:textColor="@color/event_item_text"
            android:textSize="13sp"
            android:transitionName="organizationLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix"
            tools:text="Фонд Росконгресс" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEventDate"
            fontPath="fonts/Robotoans-Light.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:textColor="@color/event_item_text"
            android:textSize="17sp"
            android:transitionName="eventDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOrganizationLabel"
            tools:ignore="MissingPrefix"
            tools:text="5.02.19 - 30.06.19" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEventLabel"
            fontPath="fonts/Roboto-Medium.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/event_item_text"
            android:textSize="17sp"
            android:transitionName="eventLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvEventDate"
            tools:text="Заседание общественного совета при министерстве природных. Заседание общественного совета при министерстве природных. Заседание общественного совета при министерстве природных. Заседание общественного совета при министерстве природных. " />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvShowMore"
            fontPath="fonts/Roboto-Medium.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/background_button_underline"
            android:minHeight="48dp"
            android:text="@string/show_more"
            android:textColor="@color/event_item_text"
            android:textSize="15sp"
            android:transitionName="eventLabel"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvEventLabel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGoToEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:layout_marginBottom="20dp"
            android:background="@drawable/background_corners"
            android:minHeight="@dimen/action_button_height"
            android:text="@string/go_to_event"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:theme="@style/ViewBackgroundAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvShowMore"
            app:layout_constraintVertical_bias="1.0"
            tools:background="@color/colorAccent"
            tools:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvShowMore"
            app:layout_constraintVertical_bias="1.0"
            tools:background="@color/event_status_approved_background"
            tools:text="@string/event_status_approved"
            tools:textColor="@color/event_status_approved_text"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>