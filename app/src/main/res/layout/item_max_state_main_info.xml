<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layPhoto"
        style="@style/Profile.Edit.InputContainer">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.TextViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_photo" />

        <LinearLayout
            style="@style/Profile.Edit.InputContainer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/background_corners"
                android:contentDescription="@string/content_description_avatar"
                tools:src="@drawable/avatar_placeholder_rectangle" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:minHeight="32dp"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:text="@string/user_profile_edit"
                android:textAllCaps="false"
                android:textColor="@color/colorAccent"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layWorkPhone"
        style="@style/Profile.Edit.InputContainer">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.TextViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_phone_work" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilWorkPhone"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkPhone"
                style="@style/Profile.Edit.Input.SingleLine"
                android:digits=" 0123456789()-+"
                android:hint="@string/profile_phone_work"
                android:inputType="phone" />
        </com.example.ui.views.CustomTextInputLayout>

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scShowWorkPhone"
            style="@style/Profile.Edit.Switch"
            android:text="@string/profile_show_in_profile" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scNoWorkPhone"
            style="@style/Profile.Edit.Switch"
            android:text="@string/user_profile_no_work_phone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layNetwork"
        style="@style/Profile.Edit.InputContainer"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.TextViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/social_networks" />

        <LinearLayout
            android:id="@+id/llSocialNetworks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/networksError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:gravity="center_horizontal"
            android:text="@string/fill_field"
            android:textColor="@color/attention_action"
            android:visibility="gone"
            tools:text="@string/fill_field" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSocialNetworkAdd"
            style="@style/Profile.Edit.Button"
            android:layout_marginStart="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:layout_marginBottom="8dp"
            android:text="@string/profile_sn_add" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scNoSocialNetworks"
            style="@style/Profile.Edit.Switch"
            android:text="@string/user_profile_no_social_networks" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/laySites"
        style="@style/Profile.Edit.InputContainer"
        android:layout_marginEnd="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.TextViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_site" />

        <LinearLayout
            android:id="@+id/llSites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sitesError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:gravity="center_horizontal"
            android:text="@string/fill_field"
            android:textColor="@color/attention_action"
            android:visibility="gone"
            tools:text="@string/fill_field" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSiteAdd"
            style="@style/Profile.Edit.Button"
            android:layout_marginStart="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:layout_marginBottom="8dp"
            android:text="@string/profile_site_add" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scSite"
            style="@style/Profile.Edit.Switch"
            android:text="@string/user_profile_no_site" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layNotes"
        style="@style/Profile.Edit.InputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnAddInfo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:srcCompat="@drawable/ic_information"
                app:tint="@color/chat_list_date" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Profile.Edit.TextViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/profile_additional_data" />

        </LinearLayout>

        <com.example.ui.views.CustomTextInputLayout
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:errorEnabled="false"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                style="@style/Profile.Edit.Input"
                android:gravity="start|top"
                android:hint="@string/profile_notes"
                android:inputType="textMultiLine|textCapSentences"
                android:lines="5"
                tools:text="@tools:sample/lorem/random" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

</LinearLayout>