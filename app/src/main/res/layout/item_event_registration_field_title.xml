<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/textContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_horizontal_default"
        android:layout_marginEnd="@dimen/margin_horizontal_default"
        android:orientation="vertical">

        <View
            style="@style/ViewDivider.Horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="invisible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textView"
            fontPath="fonts/sf_pro_display_regular.OTF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:letterSpacing="-0.01"
            android:textColor="@color/profile_data_text_hint"
            android:textSize="14sp"
            tools:text="Title" />
    </LinearLayout>
</layout>
