<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_load"
        style="@style/BtnBrownStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/auth_label_login"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_button"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="15dp"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_load"
        app:layout_constraintStart_toStartOf="@id/btn_load"
        app:layout_constraintTop_toTopOf="@id/btn_load" />

    <com.example.ui.views.CustomProgressBar
        android:id="@+id/progress_load"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_load"
        app:layout_constraintEnd_toEndOf="@id/btn_load"
        app:layout_constraintStart_toStartOf="@id/btn_load"
        app:layout_constraintTop_toTopOf="@id/btn_load"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>