<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="?dialogPreferredPadding"
    android:paddingTop="16dp"
    android:paddingEnd="?dialogPreferredPadding">

    <LinearLayout
        style="@style/Profile.Edit.InputContainer"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilOldPassword"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOldPassword"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_password_old_hint"
                android:inputType="textPassword" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Profile.Edit.InputContainer"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilNewPassword"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPassword"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_password_new_hint"
                android:inputType="textPassword" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Profile.Edit.InputContainer"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilNewPasswordConfirm"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPasswordConfirm"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_password_new_repeat_hint"
                android:inputType="textPassword" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>
</LinearLayout>