<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <LinearLayout
        style="@style/Profile.Edit.InputContainer">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.InputTitle"
            android:text="@string/profile_password_old" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilOldPassword"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOldPassword"
                style="@style/Profile.Edit.Input"
                android:hint="@string/profile_password_hint"
                android:inputType="textPassword" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Profile.Edit.InputContainer">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.InputTitle"
            android:text="@string/profile_password_new" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilNewPassword"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPassword"
                style="@style/Profile.Edit.Input"
                android:hint="@string/profile_password_hint"
                android:inputType="textPassword" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Profile.Edit.InputContainer">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.InputTitle"
            android:text="@string/profile_confirm_new_password" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilNewPasswordConfirm"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPasswordConfirm"
                style="@style/Profile.Edit.Input"
                android:hint="@string/profile_password_hint"
                android:inputType="textPassword" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>
</LinearLayout>