<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_horizontal_default"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="@dimen/margin_horizontal_default"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            style="@style/Profile.Edit.ActionButton"
            android:background="@drawable/background_corners"
            android:drawableStart="@drawable/ic_save"
            android:minEms="7"
            android:text="@string/save"
            android:textColor="@color/button_save_text"
            android:theme="@style/ViewBackgroundSave"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnRevoke"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRevoke"
            style="@style/Profile.Edit.ActionButton"
            android:layout_marginStart="12dp"
            android:background="@drawable/background_button_cancel"
            android:drawableStart="@drawable/ic_revoke"
            android:minEms="7"
            android:text="@string/revoke"
            android:textColor="@color/button_cancel_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnSave"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view"
        style="@style/ViewDivider.Horizontal"
        android:layout_marginTop="24dp" />
</LinearLayout>