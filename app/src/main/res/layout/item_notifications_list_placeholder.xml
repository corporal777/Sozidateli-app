<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:layout_marginHorizontal="15dp"
    android:layout_marginVertical="10dp"
    android:layout_marginTop="10dp"
    android:elevation="10dp"
    app:cardBackgroundColor="#F6F6F6"
    app:cardCornerRadius="12dp"
    app:cardElevation="10dp">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_duration="1500">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:layout_marginEnd="@dimen/margin_forty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="90dp"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="200dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.cardview.widget.CardView>