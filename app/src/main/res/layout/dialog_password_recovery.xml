<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/main_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/profile_padding_start"
    android:paddingEnd="@dimen/profile_padding_start">

    <EditText
        android:id="@+id/etOldPassword"
        style="@style/Auth.EditText"
        android:layout_marginTop="30dp"
        android:hint="@string/profile_password_old"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:visibility="gone"
        tools:ignore="UnusedAttribute" />

    <EditText
        android:id="@+id/etPassword"
        style="@style/Auth.EditText"
        android:layout_marginTop="15dp"
        android:hint="@string/auth_input_password_hint"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        tools:ignore="UnusedAttribute" />


    <EditText
        android:id="@+id/etConfirmPassword"
        style="@style/Auth.EditText"
        android:layout_marginTop="15dp"
        android:hint="@string/recovery_confirm_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        tools:ignore="UnusedAttribute" />

    <!--suppress AndroidUnknownAttribute -->
    <com.example.ui.views.PasswordHintTextView
        android:id="@+id/tvPasswordHintLength"
        fontPath="fonts/Roboto-Light.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:text="@string/auth_hint_password_strong_1"
        android:textColor="@color/text_color_password_hint"
        tools:ignore="MissingPrefix" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/background_action_button_selector"
        android:text="@string/save"
        android:textColor="@color/text_color_action_button" />
</LinearLayout>