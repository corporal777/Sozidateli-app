<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/profile_padding_start"
    android:paddingEnd="@dimen/profile_padding_start"
    android:background="@color/main_background">

    <EditText
        android:id="@+id/etPassword"
        style="@style/Auth.EditText"
        android:layout_marginTop="30dp"
        android:hint="@string/auth_hint_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        tools:ignore="UnusedAttribute" />


    <EditText
        android:id="@+id/etConfirmPassword"
        style="@style/Auth.EditText"
        android:layout_marginTop="15dp"
        android:hint="@string/recovery_confirm_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        tools:ignore="UnusedAttribute" />
    <TextView
        android:id="@+id/tvPasswordStrong1"
        fontPath="fonts/OpenSans-Light.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:text="@string/auth_hint_password_strong_1"
        tools:ignore="MissingPrefix" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:background="@drawable/background_btn_auth"
        android:text="@string/save"
        android:layout_marginTop="20dp"
        android:textColor="@android:color/white" />



</LinearLayout>