<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="5dp"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        fontPath="fonts/sf_pro_display_semibold.ttf"
        android:layout_width="wrap_content"
        android:letterSpacing="-0.01"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_horizontal_default"
        android:layout_marginEnd="@dimen/margin_horizontal_default"
        android:text="@string/profile_files"
        android:textColor="@color/profile_section_subtitle_text"
        android:textSize="17sp" />
</LinearLayout>