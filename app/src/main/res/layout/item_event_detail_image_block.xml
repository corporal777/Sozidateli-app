<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vk_black"
            android:paddingBottom="10dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLogo"
                android:adjustViewBounds="true"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_test"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/background_gradient_down"
                app:layout_constraintBottom_toBottomOf="@id/ivLogo" />

            <TextView
                android:id="@+id/tvTitle"
                fontPath="fonts/sf_pro_display_bold.ttf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginBottom="10dp"
                tools:text="Конференция лидеров проектов победителей конкурсов"
                android:textColor="@color/white"
                android:maxLines="2"
                android:textSize="21sp"
                app:layout_constraintBottom_toTopOf="@id/tvDate"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="MissingPrefix" />

            <TextView
                android:id="@+id/tvDate"
                fontPath="fonts/sf_pro_text_semibold.ttf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                tools:text="29.02.2022 – 30.04.2022"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintBottom_toTopOf="@id/tvLocation"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="MissingPrefix" />


            <TextView
                android:id="@+id/tvLocation"
                fontPath="fonts/sf_pro_text_semibold.ttf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                tools:text="Краснодарский край, г. Сочи"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="MissingPrefix" />

        </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
