<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="MissingPrefix">

        <View
            android:id="@+id/view"
            android:layout_width="30dp"
            android:layout_height="4dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:background="@drawable/bottom_sheet_top" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="30dp"
            android:minHeight="30dp"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/tv_bottom_sheet_label"
            fontPath="fonts/sf_pro_text_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/view"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="15dp"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="@string/new_support_question_bottom_sheet_title"
            android:textSize="17sp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_bottom_sheet_label"
            android:layout_alignParentBottom="true"
            android:fillViewport="true"
            android:isScrollContainer="false"
            android:overScrollMode="never"
            android:paddingTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="15dp"
                android:orientation="vertical">

                <com.example.ui.views.CustomTextMenuView
                    android:id="@+id/etQuestionTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:inputHintText="@string/choose_support_question_theme"
                    app:inputTitleText="@string/support_question_theme" />


                <com.example.ui.views.CustomTextInputView
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:hintText="@string/support_contact_email_hint"
                    app:inputType="textEmailAddress"
                    app:titleText="@string/support_contact_email" />

                <com.example.ui.views.CustomTextInputView
                    android:id="@+id/etProblem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:hintText="Расскажите о проблеме чуть подробнее"
                    app:inputType="textCapSentences"
                    app:titleText="@string/describe_support_problem_title" />

                <com.example.ui.views.CustomTextInputView
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:hintText="Добавьте подробное описание проблемы"
                    app:inputMaxLines="500"
                    app:inputMinLines="5"
                    app:inputType="textMultiLine|textCapSentences"
                    app:titleText="@string/tell_about_support_full_problem" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/filesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingVertical="5dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="10dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="7"
                    tools:listitem="@layout/item_gallery" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clAddFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAddFile"
                        style="@style/ClickableTextView"
                        android:layout_marginTop="15dp"
                        android:text="@string/attach_image_or_file"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        fontPath="fonts/sf_pro_display.OTF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="10dp"
                        android:lineSpacingExtra="10dp"
                        android:text="@string/support_upload_file_title"
                        android:textColor="@color/input_hint_text_color"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@id/tvAddFile" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.example.ui.views.CustomCheckView
                    android:id="@+id/iv_info_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:checkViewText="@string/support_info_privacy_text"
                    app:isCheckable="true" />

                <com.example.ui.views.CustomCheckView
                    android:id="@+id/iv_file_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:checkViewText="@string/support_file_image_privacy_text"
                    app:isCheckable="true" />

                <com.example.ui.views.loading.CustomLoadingButton
                    android:id="@+id/btnSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_fifteen"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="20dp"
                    app:buttonBackground="@drawable/custom_btn_brown_selectable"
                    app:buttonMinHeight="48dp"
                    app:buttonText="@string/send" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</layout>