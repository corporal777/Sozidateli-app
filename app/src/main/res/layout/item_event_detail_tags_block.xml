<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">


    <TextView
        android:id="@+id/tvHeader"
        fontPath="fonts/sf_pro_display_bold.ttf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="25dp"
        android:letterSpacing="0.02"
        android:lineSpacingExtra="2sp"
        android:text="@string/about_event_activities"
        android:textColor="@color/vk_black"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/chip_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingPrefix" />


    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:chipSpacingHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:lineSpacing="10dp">


        <com.example.ui.views.TagChipNew
            android:id="@+id/show_more"
            fontPath="fonts/sf_pro_text_bold.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/custom_btn_tags_selectable"
            android:drawableEnd="@drawable/ic_arrow_down_for_tags"
            android:minHeight="30dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="Еще 3"
            android:textAppearance="@style/CustomTagsTextAppearance.TextAppearance"
            android:textColor="#C3996C"
            android:visibility="visible" />

    </com.google.android.material.chip.ChipGroup>


</androidx.constraintlayout.widget.ConstraintLayout>

