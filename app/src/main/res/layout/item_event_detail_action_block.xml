<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:paddingBottom="20dp"
        tools:ignore="MissingPrefix">

        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnEventAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginVertical="10dp"
            app:buttonBackground="@drawable/custom_btn_white_ghost_selectable"
            app:buttonMinHeight="@dimen/auth_buttons_min_height"
            app:buttonText="@string/go_to_event"
            app:buttonTextColor="@color/black"
            app:buttonTextSize="@dimen/auth_button_text_size"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvCancelRegister"
            fontPath="fonts/sf_pro_text_medium.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:letterSpacing="-0.02"
            android:paddingHorizontal="10dp"
            android:text="@string/change_decision"
            android:textColor="#C3996C"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEventAction" />


        <com.example.ui.views.expandableTextView.ExpandableTextView
            android:id="@+id/tvDescription"
            fontPath="fonts/sf_pro_text.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:importantForAccessibility="no"
            android:letterSpacing="-0.02"
            android:maxLines="25"
            android:paddingHorizontal="15dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/ln"
            app:layout_constraintTop_toBottomOf="@id/tvCancelRegister"
            app:layout_goneMarginTop="20dp"
            app:limitedMaxLines="4" />

        <LinearLayout
            android:id="@+id/ln"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="25dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription">


            <LinearLayout
                android:id="@+id/format_ln"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription">

                <TextView
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="@string/format_label"
                    android:textColor="@color/white"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/tv_format"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="Конференция" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/address_ln"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/format_ln">

                <TextView
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="@string/address_label"
                    android:textColor="@color/white"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/tv_address"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#C3996C"
                    android:textSize="15sp"
                    tools:text="г. Тула, Ленина 15" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/phone_ln"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/address_ln">

                <TextView
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Телефон:"
                    android:textColor="@color/white"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/tv_phone"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#C3996C"
                    android:textSize="15sp"
                    tools:text="+7 (495) 111 -11- 22" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/email_ln"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/phone_ln">

                <TextView
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="E-mail:"
                    android:textColor="@color/white"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/tv_email"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#C3996C"
                    android:textSize="15sp"
                    tools:text="love@houseofapps.ru" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/link_ln"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/email_ln">

                <TextView
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Сайт:"
                    android:textColor="@color/white"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/tv_link"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#C3996C"
                    android:textSize="15sp"
                    tools:text="leader-russia.ru" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/network_ln"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/link_ln">

                <TextView
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Соцсеть:"
                    android:textColor="@color/white"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/tv_social_network"
                    fontPath="fonts/sf_pro_text_semibold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#C3996C"
                    android:textSize="15sp"
                    tools:text="vk.com/leader" />
            </LinearLayout>
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

