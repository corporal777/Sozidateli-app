<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/iv_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_description_close"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@drawable/ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auth_logo_height"
                android:layout_marginTop="@dimen/auth_logo_margin_top"
                android:contentDescription="@string/content_description_logo"
                android:src="@drawable/ic_app_logo_gray"
                app:layout_constraintBottom_toTopOf="@+id/tv_register_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tv_register_title"
                fontPath="fonts/sf_pro_text_semibold.ttf"
                android:letterSpacing="-0.02"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="2dp"
                android:text="@string/auth_register"
                android:textColor="@color/auth_title_text"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/ll_input"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_logo"
                tools:ignore="MissingPrefix" />

            <LinearLayout
                android:id="@+id/ll_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@+id/ib_register"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_register_title">

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/til_last_name"
                    style="@style/Profile.Edit.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    app:endIconMode="custom"
                    app:errorEnabled="true"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_last_name"
                        style="@style/Profile.Edit.Input.SingleLine"
                        android:hint="@string/auth_input_last_name_hint"
                        android:inputType="textCapSentences" />
                </com.example.ui.views.CustomTextInputLayout>

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/til_first_name"
                    style="@style/Profile.Edit.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    android:layout_marginBottom="0dp"
                    app:endIconMode="custom"
                    app:errorEnabled="true"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_first_name"
                        style="@style/Profile.Edit.Input.SingleLine"
                        android:hint="@string/auth_input_first_name_hint"
                        android:inputType="textCapSentences"/>
                </com.example.ui.views.CustomTextInputLayout>

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/til_middle_name"
                    style="@style/Profile.Edit.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    app:errorEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_middle_name"
                        style="@style/Profile.Edit.Input.SingleLine"
                        android:hint="@string/auth_input_middle_name_hint"
                        android:inputType="textCapWords" />

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/sc_no_middle_name"
                        style="@style/Profile.Edit.Switch"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/profile_edit_user_no_middle_name" />
                </com.example.ui.views.CustomTextInputLayout>

                <!--<LinearLayout
                    style="@style/Profile.Edit.InputContainer"
                    android:layout_marginTop="0dp">

                    <com.example.ui.views.PhoneView
                        android:id="@+id/etMobilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                 <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPhoneConfirmed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_vertical"
                        android:minHeight="38dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/profile_edit_phone_confirmed"
                        android:textColor="@color/profile_status_complete"
                        android:visibility="gone" />
                </LinearLayout>-->

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Profile.Edit.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    android:layout_marginBottom="8dp"
                    app:endIconMode="custom"
                    app:errorEnabled="true"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        style="@style/Profile.Edit.Input.SingleLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/auth_input_email_or_phone_hint"
                        android:inputType="textEmailAddress" />

                </com.example.ui.views.CustomTextInputLayout>

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/til_email_again"
                    style="@style/Profile.Edit.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:endIconMode="custom"
                    app:errorEnabled="true"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email_again"
                        style="@style/Profile.Edit.Input.SingleLine"
                        android:layout_marginTop="8dp"
                        android:hint="@string/auth_input_email_again_hint"
                        android:inputType="textEmailAddress" />

                </com.example.ui.views.CustomTextInputLayout>

                <!--<com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Profile.Edit.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    app:endIconMode="password_toggle"
                    app:errorEnabled="true"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        style="@style/Profile.Edit.Input.SingleLine"
                        android:hint="@string/auth_input_password_hint"
                        android:inputType="textPassword" />
                </com.example.ui.views.CustomTextInputLayout>

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/tilPasswordConfirm"
                    style="@style/Profile.Edit.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    app:endIconMode="password_toggle"
                    app:errorEnabled="true"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordConfirm"
                        style="@style/Profile.Edit.Input.SingleLine"
                        android:hint="@string/auth_input_password_confirm_hint"
                        android:inputType="textPassword" />
                </com.example.ui.views.CustomTextInputLayout>-->

                <com.example.ui.views.passwordView.PasswordCustomView
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"/>

                <TextView
                    android:id="@+id/tv_agree_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginEnd="@dimen/margin_horizontal_default"
                    android:layout_marginVertical="5dp"
                    android:gravity="center"
                    android:text="@string/auth_error_agreement"
                    android:textColor="@color/attention_action"
                    android:visibility="gone" />
            </LinearLayout>


            <androidx.appcompat.widget.AppCompatButton
                style="@style/BtnBrownStyle"
                android:layout_marginTop="10dp"
                android:minHeight="@dimen/auth_button_min_height"
                android:id="@+id/ib_register"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_horizontal_default"
                android:layout_marginVertical="20dp"
                android:layout_marginEnd="@dimen/margin_horizontal_default"
                android:text="@string/auth_action_register"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_input"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_goneMarginBottom="24dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</layout>
