<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="?dialogPreferredPadding"
    android:paddingTop="16dp"
    android:paddingEnd="?dialogPreferredPadding">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/appCompatTextView2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/profile_email_change_message"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_current"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/current_login"
        android:textSize="14sp"
        android:textColor="@color/input_hint_text_color"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appCompatTextView2"/>

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilEmail"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:errorEnabled="true"
        app:errorIconDrawable="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_current">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            style="@style/Profile.Edit.Input.SingleLine"
            android:hint="@string/current_login"
            android:inputType="textEmailAddress" />
    </com.example.ui.views.CustomTextInputLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_new"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/new_login"
        android:textSize="14sp"
        android:textColor="@color/input_hint_text_color"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilEmail"/>

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilNewEmail"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:errorEnabled="true"
        app:errorIconDrawable="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_new">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewEmail"
            style="@style/Profile.Edit.Input.SingleLine"
            android:hint="@string/new_email"
            android:inputType="textEmailAddress" />
    </com.example.ui.views.CustomTextInputLayout>

</androidx.constraintlayout.widget.ConstraintLayout>