                <!--                    app:layout_constraintEnd_toEndOf="parent"-->
                <!--                    app:layout_constraintStart_toStartOf="parent"-->
                <!--                    app:layout_constraintTop_toBottomOf="@id/listTags"-->
                <!--                    app:limitedMaxLines="5"-->
                <!--                    app:originalText="Вторая половина ХХ в. вошла в историю текстильного искусства как «вторая весна шпалеры» или эпоха «пластического взрыва». В этот период весны были созданы произведения эпоха объемно-пространственного текстиля" />-->


<!--                <TextView-->
<!--                    android:id="@+id/tvShowMore"-->
<!--                    fontPath="fonts/sf_pro_text_bold.ttf"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginStart="5dp"-->
<!--                    android:layout_marginTop="57dp"-->
<!--                    android:layout_marginEnd="30dp"-->
<!--                    android:background="@drawable/custom_text_background_selectable"-->
