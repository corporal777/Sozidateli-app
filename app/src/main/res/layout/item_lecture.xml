<!--                    app:layout_constraintBottom_toTopOf="@id/btnAddToTimetable"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintTop_toBottomOf="@id/divider" />-->


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddToTimetable"
                    fontPath="fonts/sf_pro_text_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/custom_btn_green_selectable"
                    android:letterSpacing="-0.02"
                    android:minWidth="200dp"
                    android:minHeight="40dp"
                    android:text="@string/add_to_timetable"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/desc_container" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
