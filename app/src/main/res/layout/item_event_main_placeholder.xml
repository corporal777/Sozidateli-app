<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_duration="2000"
    tools:ignore="MissingPrefix">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/event_image_height_new"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/eventImageShadow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/event_image_shadow_height_new"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo" />


        <LinearLayout
            android:id="@+id/cl_text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:orientation="vertical"
            android:paddingTop="10dp"
            app:layout_constraintTop_toTopOf="@id/eventImageShadow">

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/placeholder_background" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/placeholder_background" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/placeholder_background" />


            <View
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="100dp"
                android:background="@drawable/placeholder_background" />

        </LinearLayout>

        <View
            android:id="@+id/tvEventDate"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="200dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_text_title" />


        <View
            android:id="@+id/btnEventAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_buttons_min_height"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@+id/tvEventDate" />


        <View
            android:id="@+id/tvCancelRegister"
            android:layout_width="200dp"
            android:layout_height="16dp"
            android:layout_marginTop="21dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEventAction" />


        <View
            android:id="@+id/tvEventDescription1"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvCancelRegister" />

        <View
            android:id="@+id/tvEventDescription2"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvEventDescription1" />


        <View
            android:id="@+id/tvEventDescription3"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginHorizontal="45dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvEventDescription2" />

        <View
            android:id="@+id/tvEventDescription4"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvEventDescription3" />

        <View
            android:id="@+id/tvEventDescription5"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginHorizontal="65dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvEventDescription4" />


        <View
            android:id="@+id/tvShowMore"
            android:layout_width="150dp"
            android:layout_height="20dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEventDescription5" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>