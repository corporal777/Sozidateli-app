<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tb_content"
    android:layout_width="match_parent"
    android:layout_height="85dp">

    <View
        android:id="@+id/tb_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white" />

    <!--        <eightbitlab.com.blurview.BlurView-->
    <!--            android:id="@+id/tb_background"-->
    <!--            android:layout_width="match_parent"-->
    <!--            android:layout_height="match_parent"-->
    <!--            app:blurOverlayColor="@color/blurColorOverlay" />-->

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/toolbar_icons_size"
        android:layout_height="@dimen/toolbar_icons_size"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/about_event_toolbar_btn_background"
        android:foreground="@drawable/btn_background_toolbar"
        android:paddingTop="6dp"
        android:paddingEnd="3dp"
        android:paddingBottom="6dp"
        android:src="@drawable/ic_back_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_add_to_calendar"
        fontPath="fonts/sf_pro_text_semibold.ttf"
        android:layout_width="@dimen/toolbar_circle_button_width"
        android:layout_height="@dimen/toolbar_circle_button_height"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_background_add_calendar"
        android:text="@string/add_to_calendar"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_add_to_favorite" />

    <ImageView
        android:id="@+id/iv_add_to_favorite"
        android:layout_width="@dimen/toolbar_icons_size"
        android:layout_height="@dimen/toolbar_icons_size"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/about_event_toolbar_btn_background"
        android:foreground="@drawable/btn_background_toolbar"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_share"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/iv_share"
        android:layout_width="@dimen/toolbar_icons_size"
        android:layout_height="@dimen/toolbar_icons_size"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/about_event_toolbar_btn_background"
        android:foreground="@drawable/btn_background_toolbar"

        android:paddingHorizontal="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="5dp"
        android:src="@drawable/ic_share_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

