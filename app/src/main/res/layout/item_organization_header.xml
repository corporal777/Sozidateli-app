<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/ivBackground"
            android:layout_width="match_parent"
            android:layout_height="134dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:background="@drawable/background_corners"
            android:scaleType="centerCrop"
            android:transitionName="organization background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:src="@tools:sample/backgrounds/scenic" />


        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="20dp"
            android:background="@drawable/background_corners"
            android:scaleType="centerCrop"
            android:transitionName="organization logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBackground"
            tools:ignore="ContentDescription"
            tools:src="@tools:sample/avatars" />

        <androidx.appcompat.widget.AppCompatTextView
            fontPath="fonts/sf_pro_display_semibold.ttf"
            android:id="@+id/tvOrganizationImageName"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/background_organization_logo"
            android:gravity="center"
            android:maxLines="3"
            android:padding="4dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo"
            app:layout_constraintEnd_toEndOf="@id/ivLogo"
            app:layout_constraintStart_toStartOf="@id/ivLogo"
            app:layout_constraintTop_toTopOf="@id/ivLogo"
            tools:ignore="ContentDescription"
            tools:text="@tools:sample/full_names" />

        <TextView
            android:letterSpacing="-0.01"
            android:id="@+id/tvName"
            fontPath="fonts/sf_pro_display_semibold.ttf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/text_color_title"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toTopOf="@id/ivLogo"
            tools:ignore="MissingPrefix"
            tools:text="@tools:sample/full_names" />


        <com.example.ui.views.UserSubscribeButton
            android:id="@+id/btnAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"
            app:subscribeAction="favorite" />

        <TextView
            android:letterSpacing="-0.01"
            android:id="@+id/tvDescription"
            fontPath="fonts/sf_pro_display.OTF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="8dp"
            android:textColor="@color/profile_name_text"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/btnAction"
            tools:ignore="MissingPrefix"
            tools:text="Некоммерческий фонд по оказанию помощи бездомным, брошенным животным, а так же животным - инвалидам. Хоспис, передержка и устройство в семьи. " />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
