<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/profile_divider" />

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:id="@+id/clProfile"
            android:padding="@dimen/profile_padding_start">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@mipmap/ic_launcher" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@id/ivAvatar">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    tools:text="Avraam linkoln" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    tools:text="Ваш статус: участник" />

                <TextView
                    android:id="@+id/tvAboutStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_status_more"
                    android:textAllCaps="true"
                    android:textColor="@color/auth_email_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </android.support.constraint.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/profile_divider" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="25dp"
            android:background="@color/profile_divider" />

        <FrameLayout
            android:id="@+id/flFavorite"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_height_field"
            android:background="@android:color/white"
            android:paddingStart="@dimen/profile_padding_start"
            android:paddingEnd="@dimen/profile_padding_start">

            <TextView
                style="@style/ProfileFieldTextView"
                android:text="@string/profile_favorite" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/profile_divider" />

        <FrameLayout
            android:id="@+id/flMyEvents"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_height_field"
            android:background="@android:color/white"
            android:paddingStart="@dimen/profile_padding_start"
            android:paddingEnd="@dimen/profile_padding_start">

            <TextView
                style="@style/ProfileFieldTextView"
                android:text="@string/profile_me_events" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/profile_divider" />


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:paddingStart="@dimen/profile_padding_start"
            android:paddingEnd="@dimen/profile_padding_start">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_current_event"
                android:textAllCaps="true"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChangeCurrentEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/change"
                android:textAllCaps="true"
                android:textColor="@color/auth_email_color"
                android:textStyle="bold" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/profile_divider" />

        <LinearLayout
            android:id="@+id/llCurrentEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:padding="@dimen/profile_padding_start">

            <TextView
                android:id="@+id/tvOrganizationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Fond temp" />

            <TextView
                android:id="@+id/tvEventName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                tools:text="Российский инвестиционный форум" />

            <TextView
                android:id="@+id/tvEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                tools:text="5.02 - 30.09.18" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/profile_divider" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="25dp"
            android:background="@color/profile_divider" />

        <FrameLayout
            android:id="@+id/flAbout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_height_field"
            android:background="@android:color/white"
            android:paddingStart="@dimen/profile_padding_start"
            android:paddingEnd="@dimen/profile_padding_start">

            <TextView
                style="@style/ProfileFieldTextView"
                android:text="@string/profile_about_app" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/profile_divider" />

        <FrameLayout
            android:id="@+id/flChatSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_height_field"
            android:background="@android:color/white"
            android:paddingStart="@dimen/profile_padding_start"
            android:paddingEnd="@dimen/profile_padding_start">

            <TextView
                style="@style/ProfileFieldTextView"
                android:text="@string/profile_setting_chat" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="@color/profile_divider" />
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>