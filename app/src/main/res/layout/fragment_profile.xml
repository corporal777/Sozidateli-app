<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:paddingBottom="50dp"
    android:layout_height="match_parent">

    <ScrollView
        android:background="@color/list_background"
        android:id="@+id/profileScrollView"
        android:layout_height="match_parent"
        android:layout_width="match_parent">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical">

            <!--<include
                android:id="@+id/screenTittle"
                layout="@layout/item_screen_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_horizontal_default"
                android:layout_marginEnd="@dimen/margin_horizontal_default" />-->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@android:color/white"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingTop="2dp">

                <ImageView
                    android:background="@drawable/background_corners"
                    android:contentDescription="@string/content_description_avatar"
                    android:id="@+id/ivAvatar"
                    android:layout_height="104dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="@dimen/margin_horizontal_default"
                    android:layout_marginTop="16dp"
                    android:layout_width="104dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/avatar_placeholder" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:maxLines="2"
                    android:textColor="@color/profile_name_text"
                    android:textSize="17sp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                    app:layout_constraintTop_toTopOf="@+id/ivAvatar"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="@tools:sample/full_names" />

                <TextView
                    android:id="@+id/tvIdTitle"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_width="wrap_content"
                    android:text="@string/user_id"
                    android:textSize="17sp"
                    app:layout_constraintStart_toStartOf="@+id/tvName"
                    app:layout_constraintTop_toBottomOf="@+id/tvName" />

                <!--<androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEdit"
                    fontPath="fonts/Roboto-Medium.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/background_corners_large"
                    android:backgroundTint="@color/action_button_change_screen_background"
                    android:minHeight="38dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/profile_edit"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/tvName"
                    app:layout_constraintTop_toBottomOf="@+id/tvName"
                    app:layout_constraintVertical_bias="1.0" />-->

                <TextView
                    android:id="@+id/state_title"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_width="wrap_content"
                    android:text="@string/state"
                    android:textSize="17sp"
                    app:layout_constraintStart_toStartOf="@+id/tvIdTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvIdTitle" />

                <!--<LinearLayout
                    android:id="@+id/states_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@+id/btnAboutStates"
                    app:layout_constraintStart_toStartOf="@+id/state_title"
                    app:layout_constraintTop_toBottomOf="@+id/state_title">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnBaseState"
                        fontPath="fonts/Roboto-Medium.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/background_corners_large"
                        android:backgroundTint="@color/action_button_change_screen_background"
                        android:minHeight="38dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/base_state"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toTopOf="@+id/btnAboutStates"
                        app:layout_constraintStart_toStartOf="@+id/state_title"
                        app:layout_constraintTop_toBottomOf="@+id/state_title" />

                    <Space
                        android:id="@+id/spacer"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        app:layout_constraintStart_toEndOf="@+id/btnBaseState"
                        app:layout_constraintBottom_toBottomOf="@+id/btnBaseState"
                        app:layout_constraintTop_toTopOf="@+id/btnBaseState" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMaxState"
                        fontPath="fonts/Roboto-Medium.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="7dp"
                        android:background="@drawable/background_corners_large"
                        android:backgroundTint="@color/badge_attention_low"
                        android:minHeight="38dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/max_state"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toTopOf="@+id/btnAboutStates"
                        app:layout_constraintStart_toEndOf="@+id/spacer"
                        app:layout_constraintTop_toBottomOf="@+id/state_title" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAboutStates"
                    fontPath="fonts/Roboto-Medium.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/background_corners_large"
                    android:backgroundTint="@color/stories_progress_primary"
                    android:minHeight="38dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/about_states"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/state_title"
                    app:layout_constraintTop_toBottomOf="@+id/state_title" />-->

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvStates"
                android:layout_marginTop="20dp"
                android:text="@string/about_states" />

            <View style="@style/ViewDivider.Horizontal" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvEditProfile"
                android:text="@string/profile_edit" />

            <View style="@style/ViewDivider.Horizontal" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvSettings"
                android:text="@string/profile_settings" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvFavorite"
                android:layout_marginTop="20dp"
                android:text="@string/profile_favorite" />

            <View style="@style/ViewDivider.Horizontal" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvEvents"
                android:text="@string/profile_me_events" />

            <View style="@style/ViewDivider.Horizontal" />


            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvBanned"
                android:text="@string/profile_banned" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvAuthToWebSite"
                android:layout_marginTop="20dp"
                android:text="@string/profile_auth_to_web_site" />

            <View style="@style/ViewDivider.Horizontal" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvRate"

                android:text="@string/profile_rate" />

            <View style="@style/ViewDivider.Horizontal" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvSupport"
                android:text="@string/profile_support" />

            <View style="@style/ViewDivider.Horizontal" />

            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvAboutApplication"
                android:text="@string/profile_about_app" />


            <TextView
                style="@style/Profile.Button"
                android:id="@+id/tvLogout"
                android:layout_marginBottom="70dp"
                android:layout_marginTop="20dp"
                android:text="@string/profile_logout"
                android:textColor="@color/profile_logout_text" />
        </LinearLayout>
    </ScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>


