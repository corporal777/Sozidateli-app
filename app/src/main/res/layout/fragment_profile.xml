<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="45dp">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:visibility="gone"
            app:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/white"
                android:elevation="10dp"
                app:contentInsetStart="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/custom_toolbar_btn_background_selectable"
                        android:padding="10dp"
                        android:src="@drawable/ic_back_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <TextView
                        android:id="@+id/tv_label_small"
                        fontPath="fonts/sf_pro_display_bold.ttf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:letterSpacing="0.01"
                        android:text="@string/profile_label"
                        android:textColor="@android:color/black"
                        android:textSize="20sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="MissingPrefix" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/profileScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/main_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_bar_layout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:paddingTop="2dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="@dimen/margin_horizontal_default"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/background_corners"
                        android:contentDescription="@string/content_description_avatar"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:src="@drawable/avatar_placeholder" />

                    <TextView
                        android:id="@+id/tvName"
                        fontPath="fonts/sf_pro_display_semibold.ttf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="15dp"
                        android:maxLines="2"
                        android:textColor="@color/profile_name_text"
                        android:textSize="20sp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toTopOf="@id/state_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="@tools:sample/full_names" />


                    <TextView
                        android:letterSpacing="-0.01"
                        android:id="@+id/state_title"
                        fontPath="fonts/sf_pro_text_bold.ttf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/custom_text_background_selectable"
                        android:paddingHorizontal="5dp"
                        android:text="@string/state"
                        android:textColor="@color/main_brown_color_new"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                        app:layout_constraintStart_toEndOf="@id/ivAvatar"
                        app:layout_constraintTop_toBottomOf="@id/tvName" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEditProfile"
                    style="@style/BtnGrayWriteStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_horizontal_default"
                    android:layout_marginVertical="@dimen/margin_ten"
                    android:minHeight="35dp"
                    android:text="@string/profile_edit"
                    android:textColor="#BE9B72" />

                <View
                    style="@style/ViewDivider.Horizontal"
                    android:layout_marginTop="15dp" />


                <TextView
                    android:id="@+id/tvSettings"
                    style="@style/Profile.ButtonPages"
                    android:layout_marginTop="15dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/profile_settings"
                    app:drawableStartCompat="@drawable/ic_profile_settings_edit" />

                <TextView
                    android:id="@+id/tvFavorite"
                    style="@style/Profile.ButtonPages"                    android:layout_marginTop="5dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/profile_favorite"
                    app:drawableStartCompat="@drawable/ic_profile_favorite_edit" />

                <TextView
                    android:id="@+id/tvSessions"
                    style="@style/Profile.ButtonPages"
                    android:layout_marginTop="5dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/sessions_label"
                    app:drawableStartCompat="@drawable/ic_profile_devices_edit" />

                <View
                    style="@style/ViewDivider.Horizontal"
                    android:layout_marginTop="15dp" />

                <TextView
                    android:id="@+id/tvRate"
                    style="@style/Profile.ButtonPages"
                    android:layout_marginTop="15dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/profile_rate"
                    app:drawableStartCompat="@drawable/ic_profile_rate_edit" />

                <TextView
                    android:id="@+id/tvSupport"
                    style="@style/Profile.ButtonPages"
                    android:layout_marginTop="5dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/profile_support"
                    app:drawableStartCompat="@drawable/ic_profile_email_edit" />

                <TextView
                    android:id="@+id/tvAboutApplication"
                    style="@style/Profile.ButtonPages"
                    android:layout_marginTop="5dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/profile_about_app"
                    app:drawableStartCompat="@drawable/ic_profile_about_app_edit" />

                <TextView
                    android:id="@+id/tvChangeAccount"
                    style="@style/Profile.ButtonPages"
                    android:layout_marginTop="5dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/change_account_label"
                    app:drawableStartCompat="@drawable/ic_profile_change_account_edit" />

                <TextView
                    android:id="@+id/tvLogout"
                    style="@style/Profile.ButtonPages"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="20dp"
                    android:drawablePadding="25dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/profile_logout"
                    app:drawableStartCompat="@drawable/ic_profile_log_out_edit" />


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>



