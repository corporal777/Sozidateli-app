<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="45dp">

        <com.google.android.material.appbar.AppBarLayout
            android:visibility="gone"
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/white"
                android:elevation="10dp"
                app:contentInsetStart="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/custom_toolbar_btn_background_selectable"
                        android:padding="10dp"
                        android:src="@drawable/ic_back_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <TextView
                        android:id="@+id/tv_label_small"
                        fontPath="fonts/sf_pro_display_bold.ttf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:letterSpacing="0.01"
                        android:text="@string/profile_label"
                        android:textColor="@android:color/black"
                        android:textSize="20sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="MissingPrefix" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/profileScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/list_background"
            app:layout_constraintTop_toBottomOf="@id/app_bar_layout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:paddingTop="2dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_marginStart="@dimen/margin_horizontal_default"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/background_corners"
                        android:contentDescription="@string/content_description_avatar"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:src="@drawable/avatar_placeholder" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="16dp"
                        android:maxLines="2"
                        android:textColor="@color/profile_name_text"
                        android:textSize="17sp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
                        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="@tools:sample/full_names" />

                    <TextView
                        android:id="@+id/tvIdTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/user_id"
                        android:textSize="17sp"
                        app:layout_constraintStart_toStartOf="@+id/tvName"
                        app:layout_constraintTop_toBottomOf="@+id/tvName" />


                    <TextView
                        android:id="@+id/state_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/state"
                        android:textSize="17sp"
                        app:layout_constraintStart_toStartOf="@+id/tvIdTitle"
                        app:layout_constraintTop_toBottomOf="@+id/tvIdTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvStates"
                    style="@style/Profile.Button"
                    android:layout_marginTop="20dp"
                    android:text="@string/about_states" />

                <View style="@style/ViewDivider.Horizontal" />

                <TextView
                    android:id="@+id/tvEditProfile"
                    style="@style/Profile.Button"
                    android:text="@string/profile_edit" />

                <View style="@style/ViewDivider.Horizontal" />

                <TextView
                    android:id="@+id/tvSettings"
                    style="@style/Profile.Button"
                    android:text="@string/profile_settings" />

                <TextView
                    android:id="@+id/tvFavorite"
                    style="@style/Profile.Button"
                    android:layout_marginTop="20dp"
                    android:text="@string/profile_favorite" />

                <View style="@style/ViewDivider.Horizontal" />

                <TextView
                    android:id="@+id/tvEvents"
                    style="@style/Profile.Button"
                    android:text="@string/profile_me_events" />

                <View style="@style/ViewDivider.Horizontal" />


                <TextView
                    android:id="@+id/tvBanned"
                    style="@style/Profile.Button"
                    android:text="@string/profile_banned" />

                <TextView
                    android:id="@+id/tvAuthToWebSite"
                    style="@style/Profile.Button"
                    android:layout_marginTop="20dp"
                    android:text="@string/profile_auth_to_web_site" />

                <View style="@style/ViewDivider.Horizontal" />

                <TextView
                    android:id="@+id/tvRate"
                    style="@style/Profile.Button"

                    android:text="@string/profile_rate" />

                <View style="@style/ViewDivider.Horizontal" />

                <TextView
                    android:id="@+id/tvSupport"
                    style="@style/Profile.Button"
                    android:text="@string/profile_support" />

                <View style="@style/ViewDivider.Horizontal" />

                <TextView
                    android:id="@+id/tvAboutApplication"
                    style="@style/Profile.Button"
                    android:text="@string/profile_about_app" />


                <TextView
                    android:id="@+id/tvLogout"
                    style="@style/Profile.Button"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/profile_logout"
                    android:textColor="@color/profile_logout_text" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>



