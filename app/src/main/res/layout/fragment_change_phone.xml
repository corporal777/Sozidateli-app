<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/btnConfirm"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_description_close"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:src="@drawable/ic_close"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="@dimen/auth_login_circle_logo_height"
                    android:layout_height="@dimen/auth_login_circle_logo_height"
                    android:src="@drawable/ic_app_logo_circle"
                    app:layout_constraintBottom_toTopOf="@+id/tvPhoneTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnClose" />

                <TextView
                    android:id="@+id/tvPhoneTitle"
                    fontPath="fonts/sf_pro_display_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/profile_phone_mobile"
                    android:textColor="@color/auth_title_text"
                    android:textSize="22sp"
                    app:layout_constraintBottom_toTopOf="@+id/tvRegisterWithPhone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivLogo" />


                <TextView
                    android:id="@+id/tvRegisterWithPhone"
                    fontPath="fonts/sf_pro_display_regular.OTF"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center_horizontal"
                    android:text="@string/phone_change_description"
                    android:textColor="@color/auth_title_text"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPhoneTitle" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitlePhone"
                    style="@style/Profile.Edit.TextViewTitleThin"
                    android:layout_marginHorizontal="15dp"
                    android:text="@string/profile_phone_mobile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRegisterWithPhone" />

                <com.example.ui.views.CustomTextInputLayout
                    android:id="@+id/til_phone"
                    style="@style/TextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="5dp"
                    app:endIconDrawable="@drawable/ic_confirmed_phone_icon"
                    app:endIconMode="custom"
                    app:endIconTint="#A0B685"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitlePhone">

                    <com.example.ui.views.phoneText.PhoneFormatEditText
                        android:id="@+id/etPhone"
                        style="@style/TextInputEditTextStyle"
                        android:imeOptions="actionDone"
                        android:inputType="textNoSuggestions|phone"
                        app:phoneFormatHint="@string/auth_input_phone_hint" />
                </com.example.ui.views.CustomTextInputLayout>

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/sc_phone"
                    style="@style/Profile.Edit.Switch"
                    android:layout_width="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:text="@string/profile_show_in_profile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/til_phone"
                    tools:checked="true" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_fifteen"
            android:layout_marginVertical="10dp"
            app:buttonMinHeight="@dimen/common_button_min_height"
            app:buttonText="@string/confirm"
            app:buttonTextSize="@dimen/common_button_text_size"
            app:layout_constraintBottom_toTopOf="@id/btnSave" />

        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_fifteen"
            android:layout_marginBottom="20dp"
            app:buttonBackground="@drawable/btn_background_gray_transparent"
            app:buttonMinHeight="@dimen/common_button_min_height"
            app:buttonText="@string/save"
            app:buttonTextColor="@color/event_tabs_text_unchecked"
            app:buttonTextSize="@dimen/common_button_text_size"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>