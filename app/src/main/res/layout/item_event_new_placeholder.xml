<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/event_item_height_new"
    android:layout_marginHorizontal="15dp"
    android:layout_marginVertical="10dp"
    android:layout_marginTop="10dp"
    android:elevation="0dp"
    app:cardBackgroundColor="#14747480"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_duration="4000">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:layout_marginEnd="@dimen/margin_forty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvName" />

            <View
                android:id="@+id/tvCity"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_fifteen"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDate" />

            <View
                android:id="@+id/tvState"
                app:layout_constraintTop_toBottomOf="@id/tvCity"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toStartOf="@id/guidelineEventDate"
                app:layout_constraintStart_toStartOf="parent" />


            <View
                android:id="@+id/tvAction"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginBottom="@dimen/margin_twenty"
                android:layout_marginEnd="@dimen/margin_fifteen"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintStart_toEndOf="@id/guidelineEventDate"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.cardview.widget.CardView>

