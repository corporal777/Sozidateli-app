<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginStart="@dimen/margin_horizontal_default"
        android:layout_marginTop="22dp"
        android:background="@drawable/background_corners"
        android:contentDescription="@string/content_description_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/avatar_placeholder" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAvatarChange"
        style="@style/Profile.Edit.Button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:minEms="8"
        android:text="@string/profile_edit_change_photo"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/btnAvatarRemove"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.16"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAvatarRemove"
        style="@style/Profile.Edit.Button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="0dp"
        android:minEms="8"
        android:text="@string/profile_edit_remove_photo"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.16"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toBottomOf="@+id/btnAvatarChange" />

    <LinearLayout
        android:id="@+id/llSurname"
        style="@style/Profile.Edit.InputContainer"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/margin_horizontal_default"
        android:layout_marginEnd="@dimen/margin_horizontal_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llMiddleName">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSurname"
            style="@style/Profile.Edit.InputTitle"
            android:labelFor="@+id/etSurname"
            android:text="@string/profile_edit_user_surname" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilSurname"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSurname"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_edit_user_surname_hint"
                android:inputType="textCapWords|textPersonName" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llName"
        style="@style/Profile.Edit.InputContainer"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivAvatar">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvName"
            style="@style/Profile.Edit.InputTitle"
            android:labelFor="@+id/etName"
            android:text="@string/profile_edit_user_name" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilName"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_edit_user_name_hint"
                android:inputType="textCapWords|textPersonName" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llMiddleName"
        style="@style/Profile.Edit.InputContainer"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/margin_horizontal_default"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/margin_horizontal_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llName">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMiddleName"
            style="@style/Profile.Edit.InputTitle"
            android:text="@string/profile_edit_user_middle_name" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilMiddleName"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMiddleName"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_edit_user_middle_name_hint"
                android:inputType="textCapWords|textPersonName" />
        </com.example.ui.views.CustomTextInputLayout>

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scNoMiddleName"
            style="@style/Profile.Edit.Switch"
            android:text="@string/profile_edit_user_no_middle_name" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>