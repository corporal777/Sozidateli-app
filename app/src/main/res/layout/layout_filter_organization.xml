<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:paddingBottom="@dimen/margin_horizontal_default"
    tools:paddingEnd="@dimen/margin_horizontal_default"
    tools:paddingStart="@dimen/margin_horizontal_default"
    tools:paddingTop="@dimen/margin_horizontal_default">

    <com.example.ui.views.CustomTextInputLayout
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAddress"
            style="@style/Profile.Edit.Input.SingleLine"
            android:hint="@string/search_filter_address"
            android:inputType="textCapWords" />
    </com.example.ui.views.CustomTextInputLayout>

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilOrganizationName"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOrganizationName"
            style="@style/Profile.Edit.Input.SingleLine"
            android:hint="@string/search_filter_name"
            android:inputType="textCapSentences" />
    </com.example.ui.views.CustomTextInputLayout>

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilInn"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etInn"
            style="@style/Profile.Edit.Input.SingleLine"
            android:hint="@string/search_filter_inn"
            android:inputType="number" />
    </com.example.ui.views.CustomTextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.InputTitle"
            android:text="@string/search_filter_type" />

        <com.example.ui.views.CustomTextInputLayout
            style="@style/Profile.Edit.InputLayout.DropDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                android:id="@+id/tvType"
                style="@style/Profile.Edit.Input.SingleLine.DropDown" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Profile.Edit.InputTitle"
            android:text="@string/search_filter_subscription" />

        <com.example.ui.views.CustomTextInputLayout
            style="@style/Profile.Edit.InputLayout.DropDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                android:id="@+id/tvSubscription"
                style="@style/Profile.Edit.Input.SingleLine.DropDown" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>
</LinearLayout>