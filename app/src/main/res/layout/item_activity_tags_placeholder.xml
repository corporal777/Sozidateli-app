<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTagsTitle"
            fontPath="fonts/sf_pro_display_bold.ttf"
            android:layout_width="70dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/placeholder_background"
            android:includeFontPadding="false"
            android:text="@string/schedule_tags_title_new"
            android:textColor="@color/placeholder"
            android:textSize="22sp"
            tools:ignore="MissingPrefix" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/tagGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="20dp"
            app:chipSpacingHorizontal="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTagsTitle"
            app:lineSpacing="10dp">


            <View
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:background="@drawable/placeholder_background" />

            <View
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:background="@drawable/placeholder_background" />


            <View
                android:layout_width="150dp"
                android:layout_height="30dp"
                android:background="@drawable/placeholder_background" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>


</com.facebook.shimmer.ShimmerFrameLayout>
