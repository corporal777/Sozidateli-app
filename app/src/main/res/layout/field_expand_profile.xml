<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/profile_padding_start"
        android:layout_toStartOf="@id/ivArrow"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/black"
        android:textSize="16sp" />


    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/profile_padding_start"
        android:rotation="90"
        android:src="@drawable/ic_keyboard_arrow_right" />

    <View style="@style/ViewDivider.Horizontal" />

    <View
        android:id="@+id/bottomDivider"
        style="@style/ViewDivider.Horizontal"
        android:layout_below="@id/fieldRecyclerView" />


    <android.support.v7.widget.RecyclerView
        android:id="@+id/fieldRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvName"
        android:layout_marginTop="15dp"
        android:visibility="gone" />


</RelativeLayout>