<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <androidx.cardview.widget.CardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="15dp"
            android:foreground="@drawable/custom_text_background_selectable"
            android:maxHeight="95dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageView
                android:id="@+id/event_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/event_image_header_gradient"
                android:scaleType="centerCrop"
                android:src="@drawable/img_test" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/event_image_header_gradient" />

            <TextView
                android:id="@+id/event_title"
                fontPath="fonts/sf_pro_display_bold.ttf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.02"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="21sp"
                tools:text="Конференция лидеров " />


        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>