<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout style="@style/EventRegistrationItemContainer">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textView"
            fontPath="fonts/sf_pro_display_regular.OTF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:letterSpacing="-0.01"
            android:textColor="@color/profile_data_text_hint"
            android:textSize="14sp"
            tools:text="Title" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/baseTextInputLayout"
            style="@style/Profile.Edit.PasswordNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textInputEditText"
                style="@style/Profile.Edit.InputEventRegister"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false" />
        </com.example.ui.views.CustomTextInputLayout>

        <View style="@style/ViewDivider.Form" />
    </LinearLayout>
</layout>
