<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout style="@style/EventRegistrationItemContainer">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textView"
            style="@style/Profile.Edit.InputEventRegisterTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Title" />

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/baseTextInputLayout"
            style="@style/Profile.Edit.PasswordNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:endIconDrawable="@drawable/drawable_drop_down_switch"
            app:endIconMode="dropdown_menu"
            app:endIconTint="#C3996C"
            app:layout_constraintTop_toBottomOf="@id/textView">

            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                android:id="@+id/autoCompleteTextView"
                style="@style/Profile.Edit.InputEventRegister"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:paddingStart="@dimen/profile_first_expand_margin_top"
                android:paddingEnd="@dimen/background_input_padding" />
        </com.example.ui.views.CustomTextInputLayout>

        <View
            android:id="@+id/viewInputError"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/background_input_frame_error"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/baseTextInputLayout"
            app:layout_constraintEnd_toEndOf="@id/baseTextInputLayout"
            app:layout_constraintStart_toStartOf="@id/baseTextInputLayout"
            app:layout_constraintTop_toTopOf="@id/baseTextInputLayout"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
