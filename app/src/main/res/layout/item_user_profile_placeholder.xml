<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp">

        <View
            android:id="@+id/ivAvatar"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/tvName"
            android:layout_width="250dp"
            android:layout_height="20dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivAvatar"
            tools:ignore="MissingPrefix" />

        <View
            android:id="@+id/tvId"
            android:layout_width="150dp"
            android:layout_height="15dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvName"
            tools:ignore="MissingPrefix" />


        <View
            android:id="@+id/btnChat"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="80dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvId" />


        <View
            android:id="@+id/tvFieldOne"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="150dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnChat"
            tools:ignore="MissingPrefix" />

        <View
            android:id="@+id/tvFieldTwo"
            android:layout_width="50dp"
            android:layout_height="15dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnChat"
            tools:ignore="MissingPrefix" />

        <View
            android:id="@+id/tvFieldThree"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="200dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFieldTwo"
            tools:ignore="MissingPrefix" />

        <View
            android:id="@+id/tvFieldFour"
            android:layout_width="50dp"
            android:layout_height="15dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFieldTwo"
            tools:ignore="MissingPrefix" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>