<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/itemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_horizontal_default"
                android:layout_marginTop="20dp"
                android:background="@color/placeholder"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toStartOf="@+id/guidelineDate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_horizontal_default"
                android:layout_marginTop="6dp"
                android:background="@color/placeholder"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toStartOf="@+id/guidelineTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDate" />

            <View
                android:id="@+id/tvMessage1"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_horizontal_default"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="@dimen/margin_horizontal_default"
                android:background="@color/placeholder"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

            <View
                android:id="@+id/tvMessage2"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_horizontal_default"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:background="@color/placeholder"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guidelineOrganizationLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMessage1" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineOrganizationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.8" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.6" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>