<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:foreground="@drawable/custom_text_background_selectable"
            app:cardBackgroundColor="#F6F6F6"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/itemContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/current_session_item_height">


                <androidx.cardview.widget.CardView
                    android:id="@+id/card_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="15dp"
                    app:cardBackgroundColor="#66BE9B72"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <ImageView
                        android:id="@+id/iv_device_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_android_device" />


                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvDeviceName"
                    fontPath="fonts/sf_pro_text.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:textColor="@color/vk_black"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toTopOf="@id/tvDeviceType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/card_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Конференция лидеров проектов победителей конкурсов" />


                <TextView
                    android:id="@+id/tvDeviceType"
                    fontPath="fonts/sf_pro_text.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="10dp"
                    android:textColor="@color/vk_black"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toTopOf="@id/tvLocation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/card_icon"
                    app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
                    tools:text="Конференция лидеров dmlsd  cxcdcdscdscdscdskm lsmld; ml;d ;scdcdscdscls;ldl; ld,v;ldsv,dl;v,l; lds,vlds;v,dlv,dl, проектов победителей конкурсов" />

                <TextView
                    android:id="@+id/tvLocation"
                    fontPath="fonts/sf_pro_text.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="0.5"
                    android:textColor="@color/vk_black"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/card_icon"
                    app:layout_constraintTop_toBottomOf="@id/tvDeviceType"
                    tools:text="29.02.2022 – 30.04.2022" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_kill_sessions"
            fontPath="fonts/sf_pro_text_bold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginVertical="10dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/custom_btn_white_smoke_selectable"
            android:letterSpacing="-0.02"
            android:text="@string/kill_all_other_sessions"
            android:textAllCaps="false"
            android:textColor="@color/red"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_session" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
