<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Profile.Edit.InputContainer">

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/Profile.Edit.TextViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_degrees_level"/>

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilDegreesLevel"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/tvDegreesLevel"
            style="@style/Profile.Edit.Input.SingleLine"
            android:layout_marginBottom="0dp"
            android:cursorVisible="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:hint="@string/profile_degrees_level"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </com.example.ui.views.CustomTextInputLayout>

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/Profile.Edit.TextViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/profile_sciences_level"/>

    <com.example.ui.views.CustomTextInputLayout
        android:id="@+id/tilSciencesLevel"
        style="@style/Profile.Edit.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/tvSciencesLevel"
            style="@style/Profile.Edit.Input.SingleLine"
            android:layout_marginBottom="0dp"
            android:cursorVisible="false"
            android:focusable="false"
            android:clickable="false"
            android:focusableInTouchMode="false"
            android:hint="@string/profile_sciences_level"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </com.example.ui.views.CustomTextInputLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEdit"
            style="@style/Profile.Edit.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRemove"
            style="@style/Profile.Edit.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove" />

    </LinearLayout>

    <View
        style="@style/ViewDivider.Horizontal"
        android:layout_marginTop="12dp" />
</LinearLayout>