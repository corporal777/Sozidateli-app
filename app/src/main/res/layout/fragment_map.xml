<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/flMapContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible">

            <fragment
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/flMapTouchWrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/llMapAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/action_button_height"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnShare"
                android:layout_width="62dp"
                android:layout_height="match_parent"
                android:background="@drawable/background_highlight"
                android:elevation="1dp"
                android:src="@drawable/ic_show_on_map"
                android:theme="@style/ViewBackgroundMapShare" />

            <FrameLayout
                android:id="@+id/btnGoTo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/background_highlight"
                android:elevation="0dp"
                android:theme="@style/ViewBackgroundAccent">

                <androidx.appcompat.widget.AppCompatTextView
                    fontPath="fonts/OpenSans-Semibold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:drawableStart="@drawable/ic_route"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:text="@string/map_route"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescriptionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profile_padding_start"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/profile_padding_start"
            android:textAllCaps="true"
            android:textColor="@color/colorAccent"
            android:textSize="17sp"
            tools:ignore="MissingPrefix"
            tools:text="@string/event_map_tab_how_to_get" />

        <TextView
            android:id="@+id/tvDescription"
            fontPath="fonts/OpenSans-Light.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/profile_padding_start"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/profile_padding_start"
            android:layout_marginBottom="20dp"
            android:autoLink="all"
            android:textSize="16sp"
            tools:ignore="MissingPrefix"
            tools:text="@tools:sample/lorem/random" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>