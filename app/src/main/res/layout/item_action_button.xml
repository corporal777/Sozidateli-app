<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_button_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/action_button_margin_horizontal"
        android:layout_marginTop="@dimen/action_button_margin_vertical"
        android:layout_marginEnd="@dimen/action_button_margin_horizontal"
        android:layout_marginBottom="@dimen/action_button_margin_vertical"
        android:background="@drawable/background_action_button_selector"
        android:textAllCaps="false"
        android:textColor="@color/text_color_action_button"
        tools:text="@string/save" />
</FrameLayout>