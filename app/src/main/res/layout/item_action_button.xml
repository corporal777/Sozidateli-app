<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.example.ui.views.loading.CustomLoadingButton
            android:id="@+id/btnAction"
            style="@style/BtnLoadingStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/action_button_margin_horizontal"
            android:layout_marginTop="@dimen/action_button_margin_vertical"
            android:layout_marginEnd="@dimen/action_button_margin_horizontal"
            android:layout_marginBottom="@dimen/action_button_margin_vertical" />
    </FrameLayout>
</layout>
