<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingStart="@dimen/profile_padding_start"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/profile_padding_start"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvOrganizationLabel"
            fontPath="fonts/OpenSans-Bold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            tools:ignore="MissingPrefix"
            tools:text="Министерство природных ресурсов Амурской области" />

        <TextView
            android:id="@+id/tvEventDate"
            fontPath="fonts/OpenSans-Light.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp"
            tools:ignore="MissingPrefix"
            tools:text="5.02.19 - 30.06.19" />

        <TextView
            android:id="@+id/tvEventInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="17sp"
            tools:text="Заседание общественного совета при министерстве природных ресурсов области по подведению итогов конкурса" />
    </LinearLayout>

    <View style="@style/ViewDivider.Horizontal" />

    <LinearLayout
        android:id="@+id/llFormTitleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/profile_padding_start"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/profile_padding_start"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvFormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            tools:ignore="MissingPrefix"
            tools:text="Анкета козоводов России, а также какой-то длинный заголовок анкеты" />

        <TextView
            android:id="@+id/tvFormDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp"
            tools:ignore="MissingPrefix"
            tools:text="Развитие сельского хозяйства для личных подсобных хозяйств и крестьянско-фермерских хозяйств" />
    </LinearLayout>
</LinearLayout>