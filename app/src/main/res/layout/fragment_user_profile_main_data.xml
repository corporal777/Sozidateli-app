<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="vertical">

        <View
            android:visibility="gone"
            style="@style/ViewDivider.Horizontal"
            android:id="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/btnEdit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical">

                <!--<androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/user_profile_last_name" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLastName"
                    style="@style/Profile.User.Data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_profile_last_name_hint" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_profile_name" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvName"
                    style="@style/Profile.User.Data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_profile_name_hint" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMiddleNameTitle"
                    style="@style/Profile.User.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_profile_middle_name" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMiddleName"
                    style="@style/Profile.User.Data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_profile_middle_name_hint" />-->

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Title"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:text="@string/user_profile_birthday" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Data"
                    android:hint="@string/user_profile_additional_hint"
                    android:id="@+id/tvBirthday"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Title"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:text="@string/user_profile_gender" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Data"
                    android:hint="@string/user_profile_additional_hint"
                    android:id="@+id/tvGender"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Title"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:text="@string/user_profile_address" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Data"
                    android:hint="@string/user_profile_additional_hint"
                    android:id="@+id/tvAddress"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Title"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:text="@string/user_profile_additional" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Data"
                    android:ellipsize="end"
                    android:hint="@string/user_profile_additional_hint"
                    android:id="@+id/tvAdditional"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:maxLines="5" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Title"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:text="@string/user_profile_files" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.User.Data"
                    android:hint="@string/user_profile_files_hint"
                    android:id="@+id/tvFiles"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEdit"
            style="@style/BtnBrownStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:minHeight="@dimen/auth_button_min_height"
            android:layout_marginBottom="24dp"
            android:text="@string/user_profile_edit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>