<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Profile.Edit.InputContainer"
            android:layout_marginTop="15dp">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Profile.Edit.TextViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_birthday" />

            <com.example.ui.views.CustomTextInputLayout
                android:id="@+id/tilBirthday"
                style="@style/ProfileData.InputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconDrawable="@drawable/ic_calendar_new"
                app:endIconMode="custom"
                app:endIconTint="#C3996C">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBirthday"
                    style="@style/ProfileData.EditText"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="@string/profile_birthday"
                    tools:text="20.05.2023" />
            </com.example.ui.views.CustomTextInputLayout>

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/scBirthday"
                style="@style/Profile.Edit.Switch"
                android:layout_marginTop="5dp"
                android:text="@string/profile_show_in_profile" />
        </LinearLayout>

        <LinearLayout style="@style/Profile.Edit.InputContainer">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Profile.Edit.TextViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_gender" />

            <com.example.ui.views.CustomTextInputLayout
                style="@style/ProfileData.InputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconDrawable="@drawable/ic_drop_down_new"
                app:endIconMode="dropdown_menu"
                app:endIconTint="#C3996C">

                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                    android:id="@+id/tvGender"
                    style="@style/ProfileData.EditText"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="@string/profile_gender"
                    android:paddingStart="@dimen/profile_first_expand_margin_top"
                    android:paddingEnd="@dimen/profile_first_expand_margin_top" />
            </com.example.ui.views.CustomTextInputLayout>

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/scGender"
                style="@style/Profile.Edit.Switch"
                android:layout_marginTop="5dp"
                android:text="@string/profile_show_in_profile" />
        </LinearLayout>

        <LinearLayout style="@style/Profile.Edit.InputContainer">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Profile.Edit.TextViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_city" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRegion"
                style="@style/ProfileData.TextView"
                android:drawableEnd="@drawable/ic_drop_down_right"
                android:hint="@string/search_filter_region" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCity"
                style="@style/ProfileData.TextView"
                android:layout_marginTop="10dp"
                android:drawableEnd="@drawable/ic_drop_down_right"
                android:enabled="false"
                android:hint="@string/profile_locality" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/scCity"
                style="@style/Profile.Edit.Switch"
                android:layout_marginTop="5dp"
                android:text="@string/profile_show_in_profile" />
        </LinearLayout>

        <LinearLayout
            style="@style/Profile.Edit.InputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Profile.Edit.TextViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_additional_data_and_files" />

            <com.example.ui.views.CustomTextInputLayout
                android:id="@+id/til_notes"
                style="@style/ProfileData.InputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="custom"
                app:endIconTint="#C3996C"
                app:errorEnabled="false"
                app:errorIconDrawable="@null">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    style="@style/ProfileData.EditText"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="start|top"
                    android:hint="@string/profile_notes_absent"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textColor="@color/input_hint_text_color"
                    tools:text="@tools:sample/lorem/random" />
            </com.example.ui.views.CustomTextInputLayout>

            <TextView
                android:id="@+id/tvEditNotes"
                style="@style/ClickableTextView"
                android:layout_marginTop="10dp"
                android:text="@string/edit_title"
                tools:ignore="MissingPrefix" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/scNotes"
                style="@style/Profile.Edit.Switch"
                android:text="@string/profile_show_in_profile" />
        </LinearLayout>
    </LinearLayout>
</layout>
