<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/Profile.Edit.InputContainer">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEmail"
            style="@style/Profile.Edit.Input.SingleLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:gravity="center_vertical"
            android:hint="@string/profile_edit_email_hint"
            android:textAllCaps="false"
            android:textStyle="normal" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scShowEmail"
            style="@style/Profile.Edit.Switch"
            android:text="@string/profile_show_in_profile" />
    </LinearLayout>

    <LinearLayout style="@style/Profile.Edit.InputContainer">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilMobilePhone"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMobilePhone"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_phone_mobile"
                android:inputType="phone" />
        </com.example.ui.views.CustomTextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPasswordConfirm"
            style="@style/Profile.Edit.Button"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/profile_edit_confirm_password"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPhoneConfirmed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:minHeight="38dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/profile_edit_phone_confirmed"
            android:textColor="@color/profile_status_complete"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scMobilePhone"
            style="@style/Profile.Edit.Switch"
            android:text="@string/profile_show_in_profile"
            tools:checked="true" />
    </LinearLayout>

    <LinearLayout style="@style/Profile.Edit.InputContainer">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilWorkPhone"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:errorEnabled="true"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkPhone"
                style="@style/Profile.Edit.Input.SingleLine"
                android:digits=" 0123456789()-+"
                android:hint="@string/profile_phone_work"
                android:inputType="phone" />
        </com.example.ui.views.CustomTextInputLayout>

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scWorkPhone"
            style="@style/Profile.Edit.Switch"
            android:text="@string/profile_show_in_profile" />
    </LinearLayout>

    <LinearLayout style="@style/Profile.Edit.InputContainer">

        <com.example.ui.views.CustomTextInputLayout
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconDrawable="@drawable/ic_drop_down"
            app:endIconMode="dropdown_menu">

            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                android:id="@+id/tvGender"
                style="@style/Profile.Edit.Input.SingleLine"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:hint="@string/profile_gender"
                android:paddingStart="@dimen/background_input_padding"
                android:paddingEnd="@dimen/background_input_padding" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Profile.Edit.InputContainer"
        android:layout_marginTop="48dp">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/tilBirthday"
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBirthday"
                style="@style/Profile.Edit.Input.SingleLine"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:hint="@string/profile_birthday" />
        </com.example.ui.views.CustomTextInputLayout>

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/scBirthday"
            style="@style/Profile.Edit.Switch"
            android:layout_marginTop="16dp"
            android:text="@string/profile_show_in_profile" />
    </LinearLayout>

    <LinearLayout style="@style/Profile.Edit.InputContainer">

        <com.example.ui.views.CustomTextInputLayout
            style="@style/Profile.Edit.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="none">

            <com.example.ui.views.suggestFieldView.DaDataAutoCompleteTextView
                android:id="@+id/etCity"
                style="@style/Profile.Edit.Input.SingleLine"
                android:hint="@string/profile_city"
                android:inputType="textCapSentences"
                android:minHeight="48dp"
                android:paddingStart="@dimen/background_input_padding"
                android:paddingEnd="@dimen/background_input_padding" />
        </com.example.ui.views.CustomTextInputLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Profile.Edit.InputContainer"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="0dp">

        <LinearLayout
            android:id="@+id/llSocialNetworks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSocialNetworkAdd"
            style="@style/Profile.Edit.Button"
            android:layout_marginStart="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:layout_marginBottom="8dp"
            android:text="@string/profile_sn_add"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/btnAvatarRemove"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivAvatar"
            app:layout_constraintTop_toTopOf="@+id/ivAvatar"
            app:layout_constraintVertical_chainStyle="packed" />
    </LinearLayout>
</LinearLayout>