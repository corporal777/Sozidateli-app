<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="50dp"
            android:background="@drawable/placeholder_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="80dp"
            android:background="@drawable/placeholder_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="150dp"
            android:background="@drawable/placeholder_background" />


        <View
            android:layout_width="200dp"
            android:layout_height="45dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/placeholder_background"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/margin_twenty"
                android:layout_marginEnd="@dimen/margin_forty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="90dp"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>


        <View
            android:layout_width="200dp"
            android:layout_height="20dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="50dp"
            android:background="@drawable/placeholder_background" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/margin_ten"
            android:layout_height="match_parent">

            <View
                android:id="@+id/speakerLogo1"
                android:layout_width="140dp"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/tvEventDate1"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_date_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginEnd="@dimen/margin_ten"
                android:layout_marginTop="@dimen/margin_twenty"
                android:background="@drawable/placeholder_background"                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo1" />

            <View
                android:id="@+id/tvEventType1"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_date_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginEnd="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo1"
                app:layout_constraintTop_toBottomOf="@+id/tvEventDate1" />

            <View
                android:id="@+id/tvEventLabel1"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo1"
                app:layout_constraintTop_toBottomOf="@+id/tvEventType1" />

            <View
                android:id="@+id/tvEventLabel21"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo1"
                app:layout_constraintTop_toBottomOf="@+id/tvEventLabel1" />


            <View
                android:id="@+id/tvEventLabel31"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo1"
                app:layout_constraintTop_toBottomOf="@+id/tvEventLabel21" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/margin_ten"
            android:layout_height="match_parent">

            <View
                android:id="@+id/speakerLogo"
                android:layout_width="140dp"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/tvEventDate"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_date_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginEnd="@dimen/margin_ten"
                android:layout_marginTop="@dimen/margin_twenty"
                android:background="@drawable/placeholder_background"                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo" />

            <View
                android:id="@+id/tvEventType"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_date_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginEnd="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo"
                app:layout_constraintTop_toBottomOf="@+id/tvEventDate" />

            <View
                android:id="@+id/tvEventLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo"
                app:layout_constraintTop_toBottomOf="@+id/tvEventType" />

            <View
                android:id="@+id/tvEventLabel2"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo"
                app:layout_constraintTop_toBottomOf="@+id/tvEventLabel" />


            <View
                android:id="@+id/tvEventLabel3"
                android:layout_width="0dp"
                android:layout_height="@dimen/event_item_event_name_text_size"
                android:layout_marginStart="@dimen/margin_ten"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_ten"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/speakerLogo"
                app:layout_constraintTop_toBottomOf="@+id/tvEventLabel2" />

        </androidx.constraintlayout.widget.ConstraintLayout>




    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>