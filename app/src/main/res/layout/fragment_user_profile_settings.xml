<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="@color/main_background"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.TextViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/user_profile_last_name" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUserLastName"
                    style="@style/Profile.Edit.InputFieldNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_input_text_field_new"
                    android:gravity="center_vertical"
                    android:minHeight="45dp"
                    android:paddingStart="15dp"
                    android:text="@string/profile_edit_user_surname" />


                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.TextViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/user_profile_name" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUserName"
                    style="@style/Profile.Edit.InputFieldNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_input_text_field_new"
                    android:gravity="center_vertical"
                    android:minHeight="45dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"
                    android:text="@string/profile_edit_user_name" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_middle_name_title"
                    style="@style/Profile.Edit.TextViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/user_profile_middle_name" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUserMiddleName"
                    style="@style/Profile.Edit.InputFieldNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_input_text_field_new"
                    android:gravity="center_vertical"
                    android:minHeight="45dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"
                    android:text="@string/profile_edit_user_middle_name" />


                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/sc_no_middle_name"
                    style="@style/Profile.Edit.Switch"
                    android:layout_marginBottom="1dp"
                    android:enabled="false"
                    android:text="@string/profile_edit_user_no_middle_name" />

                <TextView
                    android:id="@+id/tvEditName"
                    fontPath="fonts/sf_pro_text_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/custom_text_background_selectable"
                    android:text="@string/edit_name_title"
                    android:textColor="@color/main_brown_color_new"
                    android:textSize="15sp"
                    tools:ignore="MissingPrefix" />


                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.TextViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/short_name_label" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvShortname"
                    style="@style/Profile.Edit.InputFieldNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_input_text_field_new"
                    android:gravity="center_vertical"
                    android:minHeight="45dp"
                    android:paddingHorizontal="15dp"
                    android:text="@string/short_name_label" />

                <TextView
                    android:id="@+id/tvEditShortName"
                    fontPath="fonts/sf_pro_text_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/custom_text_background_selectable"
                    android:text="@string/edit_title"
                    android:textColor="@color/main_brown_color_new"
                    android:textSize="15sp"
                    tools:ignore="MissingPrefix" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.TextViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/profile_phone_mobile" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPhoneMobile"
                    style="@style/Profile.Edit.InputFieldNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_input_text_field_new"
                    android:gravity="center_vertical"
                    android:minHeight="45dp"
                    android:paddingHorizontal="15dp"
                    android:text="@string/profile_phone_mobile" />

                <TextView
                    android:id="@+id/tvEditPhone"
                    fontPath="fonts/sf_pro_text_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/custom_text_background_selectable"
                    android:text="@string/edit_title"
                    android:textColor="@color/main_brown_color_new"
                    android:textSize="15sp"
                    tools:ignore="MissingPrefix" />


                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.TextViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/user_profile_password_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPassword"
                    style="@style/Profile.Edit.InputFieldNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_input_text_field_new"
                    android:gravity="center_vertical"
                    android:minHeight="45dp"
                    android:paddingHorizontal="15dp"
                    android:text="●●●●●●●●●" />

                <TextView
                    android:id="@+id/tvEditPassword"
                    fontPath="fonts/sf_pro_text_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/custom_text_background_selectable"
                    android:text="@string/profile_password_change"
                    android:textColor="@color/main_brown_color_new"
                    android:textSize="15sp"
                    tools:ignore="MissingPrefix" />


                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.TextViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/user_profile_email_title" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvEmail"
                        style="@style/Profile.Edit.InputFieldNew"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_input_text_field_new"
                        android:gravity="center_vertical"
                        android:minHeight="45dp"
                        android:paddingHorizontal="15dp"
                        android:text="@string/user_profile_email_title"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivInfo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <ImageView
                        android:id="@+id/ivInfo"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:padding="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvEmail"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_info_us" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvEditEmail"
                    fontPath="fonts/sf_pro_text_bold.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/custom_text_background_selectable"
                    android:text="@string/edit_title"
                    android:textColor="@color/main_brown_color_new"
                    android:textSize="15sp"
                    tools:ignore="MissingPrefix" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Profile.Edit.TextViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                android:text="@string/confidence_label" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <com.example.ui.views.dialogs_new.CustomCheckView
                    android:id="@+id/iv_privacy_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="5dp"
                    android:src="@drawable/drawable_switch"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.BlockTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/user_profile_privacy_hidden"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_privacy_profile"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Profile.Edit.TextViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                android:text="@string/control_sending" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <com.example.ui.views.dialogs_new.CustomCheckView
                    android:id="@+id/iv_block_project"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="5dp"
                    android:src="@drawable/drawable_switch"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.BlockTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/user_profile_off_messaging_projects"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_block_project"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <com.example.ui.views.dialogs_new.CustomCheckView
                    android:id="@+id/iv_block_event"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="5dp"
                    android:src="@drawable/drawable_switch"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.BlockTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/user_profile_off_messaging_events"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_block_event"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <com.example.ui.views.dialogs_new.CustomCheckView
                    android:id="@+id/iv_block_org"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="5dp"
                    android:src="@drawable/drawable_switch"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Profile.Edit.BlockTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/user_profile_off_messaging_organizations"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_block_org"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeleteProfile"
                fontPath="fonts/sf_pro_text_bold.ttf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_horizontal_default"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/custom_btn_white_smoke_selectable"
                android:letterSpacing="-0.02"
                android:text="@string/user_profile_delete_profile"
                android:textAllCaps="false"
                android:textColor="@color/red_new"
                android:textSize="16sp" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>


