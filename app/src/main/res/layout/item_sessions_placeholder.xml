<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="5dp"
        android:elevation="0dp"
        app:cardBackgroundColor="#F6F6F6"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_duration="1500">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/vIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:background="@drawable/placeholder_background"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDeviceName"
                    fontPath="fonts/sf_pro_text.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/placeholder_background"
                    android:includeFontPadding="false"
                    android:text="Конференция лидеров проектов"
                    android:textColor="@color/placeholder"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toTopOf="@id/tvDeviceType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vIcon"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/tvDeviceType"
                    fontPath="fonts/sf_pro_text.ttf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="30dp"
                    android:background="@drawable/placeholder_background"
                    android:includeFontPadding="false"
                    android:text="Конференция лидеров dmlsd"
                    android:textColor="@color/placeholder"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toTopOf="@id/tvLocation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvDeviceName" />

                <TextView
                    android:id="@+id/tvLocation"
                    fontPath="fonts/sf_pro_text.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/placeholder_background"
                    android:includeFontPadding="false"
                    android:text="Moscow, Russia • в сети"
                    android:textColor="@color/placeholder"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvDeviceType" />
            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.facebook.shimmer.ShimmerFrameLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="10dp"
        android:elevation="0dp"
        android:minHeight="@dimen/common_button_min_height"
        app:cardBackgroundColor="#F6F6F6"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp" />

</LinearLayout>