<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <View
            android:id="@+id/ivBackground"
            android:layout_width="match_parent"
            android:layout_height="134dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <View
            android:id="@+id/ivLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="20dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBackground" />

        <View
            android:layout_marginTop="10dp"
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/profile_avatar_size"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintBottom_toTopOf="@id/tvName2"
            app:layout_constraintTop_toTopOf="@id/ivLogo" />

        <View
            android:id="@+id/tvName2"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/profile_avatar_size"
            android:background="@drawable/placeholder_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvName3"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toBottomOf="@+id/tvName"/>

        <View
            android:layout_marginBottom="10dp"
            android:id="@+id/tvName3"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/profile_avatar_size"
            android:background="@drawable/placeholder_background"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toBottomOf="@+id/tvName2" />


        <View
            android:id="@+id/btnAction"
            android:layout_width="200dp"
            android:layout_height="45dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:background="@drawable/placeholder_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <View
            android:id="@+id/tvDescription0"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="10dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/btnAction" />

        <View
            android:id="@+id/tvDescription1"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/profile_data_margin"
            android:layout_marginTop="8dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvDescription0" />

        <View
            android:id="@+id/tvDescription2"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="8dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvDescription1" />

        <View
            android:id="@+id/tvDescription3"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/add_schedule_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvDescription2" />


        <View
            android:id="@+id/tvDescription7"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="8dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvDescription3" />

        <View
            android:id="@+id/tvDescriptionLast"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/profile_data_margin"
            android:layout_marginTop="8dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintTop_toBottomOf="@id/tvDescription7" />

        <View
            android:id="@+id/tvTitle"
            android:layout_width="250dp"
            android:layout_height="15dp"
            android:layout_marginStart="@dimen/margin_horizontal_default"
            android:layout_marginTop="40dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescriptionLast" />

        <View
            android:id="@+id/tvDescription4"
            android:layout_width="150dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="10dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <View
            android:id="@+id/tvDescription5"
            android:layout_width="200dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="10dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription4" />


        <View
            android:id="@+id/tvDescription6"
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="10dp"
            android:background="@drawable/placeholder_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription5" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>