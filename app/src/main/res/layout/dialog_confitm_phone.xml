<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_corners"
    android:paddingStart="@dimen/margin_horizontal_default"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/margin_horizontal_default"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvMessage"
        fontPath="fonts/sf_pro_display.OTF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.01"
        android:text="@string/confirm_phone_text"
        android:textColor="@color/dialog_event_registration_profile_fields_message"
        android:textSize="16sp"
        android:breakStrategy="simple"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="0dp"
        tools:ignore="MissingPrefix"
        tools:text="@string/confirm_phone_text"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPositive"
        style="@style/BtnBrownStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/confirm_phone_positive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMessage"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNegative"
        style="@style/BtnCancelStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnPositive"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>