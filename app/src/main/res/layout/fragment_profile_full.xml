<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="15dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/profile_divider" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/profile_padding_start">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@mipmap/ic_launcher" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@id/ivAvatar">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    tools:text="Avraam linkoln" />

                <TextView
                    android:id="@+id/tvId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="@color/hint_gray"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    tools:text="id2313" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/profile_divider" />

        <LinearLayout
            android:id="@+id/llEmail"
            style="@style/ProfileInfoField">

            <TextView
                style="@style/ProfileInfoField.Label"
                android:text="@string/email" />

            <TextView
                android:id="@+id/tvEmail"
                style="@style/ProfileInfoField.Text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llPhone"
            style="@style/ProfileInfoField">

            <TextView
                style="@style/ProfileInfoField.Label"
                android:text="@string/profile_phone" />

            <TextView
                android:id="@+id/tvPhone"
                style="@style/ProfileInfoField.Text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llBirthday"
            style="@style/ProfileInfoField">

            <TextView
                style="@style/ProfileInfoField.Label"
                android:text="@string/profile_birthday" />

            <TextView
                android:id="@+id/tvBirthday"
                style="@style/ProfileInfoField.Text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCity"
            style="@style/ProfileInfoField">

            <TextView
                style="@style/ProfileInfoField.Label"
                android:text="@string/profile_city" />

            <TextView
                android:id="@+id/tvCity"
                style="@style/ProfileInfoField.Text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llSN"
            style="@style/ProfileInfoField">

            <TextView
                style="@style/ProfileInfoField.Label"
                android:text="@string/profile_sn" />

            <TextView
                android:id="@+id/tvSn"
                style="@style/ProfileInfoField.Text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llEducation"
            style="@style/ProfileInfoField">

            <TextView
                style="@style/ProfileInfoField.Label"
                android:text="@string/profile_education" />

            <TextView
                android:id="@+id/tvEducation"
                style="@style/ProfileInfoField.Text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="@color/profile_divider" />

        <com.example.ui.views.ExpandedInfo
            android:id="@+id/eiInstitution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>