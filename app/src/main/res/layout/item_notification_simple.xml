<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:id="@+id/tv_date"
            fontPath="fonts/sf_pro_text_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textSize="18sp"
            android:visibility="gone"
            tools:text="Вторник, 1 марта"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_simple_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/background_notification_normal"
            android:elevation="9dp"
            android:paddingBottom="20dp">

            <View
                android:id="@+id/view_badge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/background_badge_attention_high"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Notification.Title"
                android:text="@string/notifications_simple_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingPrefix" />

            <com.example.ui.views.expandableTextView.CustomExpandableTextView
                android:id="@+id/tvMessage"
                style="@style/Notification.Message"
                app:layout_constraintBottom_toTopOf="@+id/btnMarkAsRead"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:layout_constraintVertical_bias="0.0"
                app:layout_goneMarginBottom="10dp"
                tools:ignore="MissingPrefix"
                tools:text="@string/about_additional_info_text" />


            <com.example.ui.views.loading.CustomLoadingButton
                android:id="@+id/btnMarkAsRead"
                style="@style/BtnLoadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_horizontal_default"
                android:layout_marginTop="15dp"

                app:buttonMinHeight="36dp"
                app:buttonTextSize="14sp"
                app:buttonText="@string/notifications_mark_as_read"
                app:buttonPaddingHorizontal="10dp"

                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMessage"
                tools:visibility="visible" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>


</layout>