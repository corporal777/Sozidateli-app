<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp"
    tools:background="@color/notification_center_notification_read">

    <TextView
        android:id="@+id/tvDate"
        style="@style/Notification.Date"
        fontPath="fonts/OpenSans-Light.ttf"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingPrefix"
        tools:text="@tools:sample/date/ddmmyy" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Notification.Title"
        android:text="@string/notifications_simple_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDate" />

    <TextView
        android:id="@+id/tvMessage"
        style="@style/Notification.Message"
        fontPath="fonts/OpenSans-Light.ttf"
        android:ellipsize="end"
        android:maxLength="200"
        app:layout_constraintBottom_toTopOf="@+id/btnMarkAsRead"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintVertical_bias="0.0"
        app:layout_goneMarginBottom="10dp"
        tools:ignore="MissingPrefix"
        tools:text="@tools:sample/lorem/random" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReadMore"
        style="@style/Notification.ReadMore"
        fontPath="fonts/OpenSans-Bold.ttf"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvWasRead"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMessage" />

    <TextView
        android:id="@+id/tvWasRead"
        style="@style/Notification.Action"
        fontPath="fonts/OpenSans-Semibold.ttf"
        android:layout_marginBottom="10dp"
        android:text="@string/notifications_was_read"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnReadMore"
        app:layout_goneMarginTop="16dp"
        tools:ignore="MissingPrefix" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMarkAsRead"
        style="@style/Notification.ActionButton"
        fontPath="fonts/OpenSans-Bold.ttf"
        android:text="@string/notifications_mark_as_read"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMessage"
        tools:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>