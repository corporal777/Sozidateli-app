<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_duration="1500">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/view1"
                android:layout_width="150dp"
                android:layout_height="30dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="10dp"
                android:background="@drawable/placeholder_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view2"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/margin_fifteen"
                android:background="@drawable/placeholder_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/view1"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view3"
                android:layout_width="250dp"
                android:layout_height="30dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="10dp"
                android:background="@drawable/placeholder_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view1" />

            <View
                android:id="@+id/view4"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/margin_fifteen"
                android:background="@drawable/placeholder_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/view3"
                app:layout_constraintTop_toBottomOf="@id/view1" />

            <View
                android:id="@+id/view5"
                android:layout_width="150dp"
                android:layout_height="30dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="10dp"
                android:background="@drawable/placeholder_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view3" />

            <View
                android:id="@+id/view6"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/margin_fifteen"
                android:background="@drawable/placeholder_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/view5"
                app:layout_constraintTop_toBottomOf="@id/view3" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="200dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/margin_fifteen"
            android:layout_marginTop="30dp"
            android:background="@drawable/placeholder_background"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/background_sessions_corners"
            android:elevation="12dp"
            android:minHeight="250dp"
            android:orientation="vertical">

            <View
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:layout_marginEnd="@dimen/margin_forty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="90dp"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="200dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/background_sessions_corners"
            android:elevation="12dp"
            android:minHeight="250dp"
            android:orientation="vertical">

            <View
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/event_item_organization_name_margin_top"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:layout_marginEnd="@dimen/margin_forty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="90dp"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/margin_seventy"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="200dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/margin_fifteen"
                android:layout_marginTop="@dimen/margin_twenty"
                android:background="@drawable/placeholder_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="130dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/margin_fifteen"
                    android:layout_marginTop="@dimen/margin_twenty"
                    android:background="@drawable/placeholder_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>


</com.facebook.shimmer.ShimmerFrameLayout>
