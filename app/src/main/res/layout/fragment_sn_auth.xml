<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background"
        tools:ignore="MissingPrefix">

        <TextView
            android:id="@+id/tvAuthTitle"
            fontPath="fonts/sf_pro_display_semibold.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="@string/which_account_to_link_vk_id"
            android:textColor="@color/auth_title_text"
            android:textSize="24sp"
            app:layout_constraintBottom_toTopOf="@id/ln_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/ln_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/background_notification_normal"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toTopOf="@id/ln_create"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <TextView
                fontPath="fonts/sf_pro_display_bold.ttf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:text="Мой аккаунт в Созидателях"
                android:textColor="@color/auth_title_text"
                android:textSize="20sp" />

            <TextView
                fontPath="fonts/sf_pro_display.OTF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:text="Войти в аккаунт и связать его \nс аккаунтом VK ID"
                android:textColor="@color/auth_title_text"
                android:textSize="16sp" />

            <com.example.ui.views.loading.CustomLoadingButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                app:buttonMinHeight="@dimen/auth_buttons_min_height"
                app:buttonText="@string/auth_label_login"
                app:buttonTextSize="@dimen/auth_buttons_text_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ln_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/background_notification_normal"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ln_login"
            app:layout_constraintVertical_chainStyle="packed">

            <TextView
                fontPath="fonts/sf_pro_display_bold.ttf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:text="Создать новый аккаунт"
                android:textColor="@color/auth_title_text"
                android:textSize="20sp" />

            <TextView
                fontPath="fonts/sf_pro_display.OTF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:text="Создать новый аккаунт и связать его \nс аккаунтом VK ID"
                android:textColor="@color/auth_title_text"
                android:textSize="16sp" />

            <com.example.ui.views.loading.CustomLoadingButton
                android:id="@+id/btn_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                app:buttonMinHeight="@dimen/auth_buttons_min_height"
                app:buttonText="@string/auth_label_create"
                app:buttonTextSize="@dimen/auth_buttons_text_size" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>