<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="@color/auth_background"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">

        <include layout="@layout/auth_logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_label_login"
            android:layout_gravity="center"
            android:textColor="@android:color/black"
            android:textSize="21sp"
            android:layout_marginTop="60dp"/>

        <EditText
            style="@style/Auth.EditText"
            android:hint="@string/email"
            android:id="@+id/etEmail"
            android:layout_marginTop="30dp"/>

        <EditText
            style="@style/Auth.EditText"
            android:id="@+id/etPassword"
            android:hint="@string/auth_hint_password"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_forgot_password"
            android:layout_marginTop="7dp"
            android:textSize="15sp"
            android:gravity="end"/>

    </LinearLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_login_btn"
        android:textColor="@android:color/white"
        android:id="@+id/btnLogin"
        android:layout_marginBottom="10dp"
        android:layout_above="@id/btnRegister"
        android:background="@drawable/background_btn_auth" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_register_btn"
        android:layout_marginBottom="10dp"
        android:id="@+id/btnRegister"
        android:textStyle="bold"
        android:textColor="@color/auth_email_color"
        android:background="@android:color/transparent"
        android:layout_alignParentBottom="true"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/ivClose"
        android:src="@drawable/ic_close_black_24dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"/>

</RelativeLayout>