<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/list_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ln_avatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/main_background"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.example.ui.views.CustomAvatarView
                    android:id="@+id/ivAvatar"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/content_description_avatar" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnEdit"
                    style="@style/ClickableTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="5dp"
                    android:text="@string/user_profile_edit"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ln_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/main_background"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMainInfo"
                    style="@style/Profile.User.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_profile_main_info" />

                <View style="@style/ViewDivider.Horizontal" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContacts"
                    style="@style/Profile.User.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_profile_contacts" />

                <View style="@style/ViewDivider.Horizontal" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnInterests"
                    style="@style/Profile.User.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_profile_interests" />

                <View style="@style/ViewDivider.Horizontal" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEducation"
                    style="@style/Profile.User.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_profile_education" />

                <View style="@style/ViewDivider.Horizontal" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExperience"
                    style="@style/Profile.User.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_profile_experience" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</layout>