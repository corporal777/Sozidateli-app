<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/EventRegistrationItemContainer"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp">

        <com.example.ui.views.CustomTextInputLayout
            android:id="@+id/baseTextInputLayout"
            style="@style/EventRegistration.InputLayout"
            android:layout_width="0dp"
            app:layout_constraintEnd_toStartOf="@+id/btnDelete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textInputEditText"
                style="@style/EventRegistration.EditText"
                tools:hint="@string/profile_phone_hint" />
        </com.example.ui.views.CustomTextInputLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description_delete"
            android:minWidth="48dp"
            android:minHeight="42dp"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="@+id/baseTextInputLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/baseTextInputLayout" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
