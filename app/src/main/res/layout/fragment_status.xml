<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStatus"
            fontPath="fonts/Roboto-Medium.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"
            android:textAllCaps="true"
            android:textSize="19sp"
            tools:text="@string/profile_status_low" />

        <LinearLayout
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSecurity"
                style="@style/Status.Description"
                fontPath="fonts/Roboto-Light.ttf"
                android:text="@string/status_security"
                tools:drawableStart="@drawable/ic_status_complete"
                tools:ignore="MissingPrefix" />

            <TextView
                android:id="@+id/tvSupport"
                style="@style/Status.Description"
                fontPath="fonts/Roboto-Light.ttf"
                android:text="@string/status_support"
                tools:drawableStart="@drawable/ic_status_complete"
                tools:ignore="MissingPrefix" />

            <TextView
                android:id="@+id/tvInvites"
                style="@style/Status.Description"
                fontPath="fonts/Roboto-Light.ttf"
                android:text="@string/status_invites"
                tools:drawableStart="@drawable/ic_status_complete"
                tools:ignore="MissingPrefix" />

            <TextView
                fontPath="fonts/Roboto-Medium.ttf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/status_conditions"
                android:textColor="@color/profile_status_your_status"
                android:textSize="19sp"
                tools:ignore="MissingPrefix" />

            <TextView
                android:id="@+id/tvPhone"
                style="@style/Status.Description"
                fontPath="fonts/Roboto-Light.ttf"
                android:layout_marginTop="16dp"
                android:text="@string/status_verified_phone"
                tools:drawableStart="@drawable/ic_status_complete"
                tools:ignore="MissingPrefix" />

            <TextView
                android:id="@+id/tvPhoneNumber"
                fontPath="fonts/Roboto-Bold.ttf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                tools:ignore="MissingPrefix"
                tools:text="+7 901 123 34 45" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAction"
                    fontPath="fonts/Roboto-Medium.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_corners"
                    android:backgroundTint="@color/colorAccent"
                    android:minHeight="38dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="@string/change" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRemove"
                    fontPath="fonts/Roboto-Medium.ttf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/background_corners"
                    android:backgroundTint="@color/colorAccent"
                    android:minHeight="38dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/remove"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btnAction"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvProfile"
                style="@style/Status.Description"
                fontPath="fonts/Roboto-Light.ttf"
                android:layout_marginTop="0dp"
                android:text="@string/status_fill_profile"
                tools:drawableStart="@drawable/ic_status_uncomplete"
                tools:ignore="MissingPrefix" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNameCounter"
                    style="@style/Status.Counter"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:text="1"
                    tools:ignore="HardcodedText,MissingPrefix" />

                <TextView
                    style="@style/Status.Description.Profile"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:layout_gravity="center_vertical"
                    android:text="@string/status_profile_name"
                    tools:ignore="MissingPrefix" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBirthdayCounter"
                    style="@style/Status.Counter"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:text="2"
                    tools:ignore="HardcodedText,MissingPrefix" />

                <TextView
                    style="@style/Status.Description.Profile"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:layout_gravity="center_vertical"
                    android:text="@string/status_profile_birthday"
                    tools:ignore="MissingPrefix" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSnCounter"
                    style="@style/Status.Counter"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:text="3"
                    tools:ignore="HardcodedText,MissingPrefix" />

                <TextView
                    style="@style/Status.Description.Profile"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:layout_gravity="center_vertical"
                    android:text="@string/status_profile_sn"
                    tools:ignore="MissingPrefix" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEducationCounter"
                    style="@style/Status.Counter"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:text="4"
                    tools:ignore="HardcodedText,MissingPrefix" />

                <TextView
                    style="@style/Status.Description.Profile"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:layout_gravity="center_vertical"
                    android:text="@string/status_profile_education"
                    tools:ignore="MissingPrefix" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWorkCounter"
                    style="@style/Status.Counter"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:text="5"
                    tools:ignore="HardcodedText,MissingPrefix" />

                <TextView
                    style="@style/Status.Description.Profile"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:layout_gravity="center_vertical"
                    android:text="@string/status_profile_work_experience"
                    tools:ignore="MissingPrefix" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAdditionalCounter"
                    style="@style/Status.Counter"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:text="6"
                    tools:ignore="HardcodedText,MissingPrefix" />

                <TextView
                    style="@style/Status.Description.Profile"
                    fontPath="fonts/Roboto-Light.ttf"
                    android:layout_gravity="center_vertical"
                    android:text="@string/status_profile_additional_data"
                    tools:ignore="MissingPrefix" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>