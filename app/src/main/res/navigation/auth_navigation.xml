<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_navigation"
    app:startDestination="@id/login_fragment">

    <fragment
        android:id="@+id/login_fragment"
        android:name="com.example.ui.auth.login.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/login_to_login_email_action"
            app:destination="@id/login_email_fragment" />

        <action
            android:id="@+id/login_to_welcome"
            app:destination="@id/welcome_fragment"
            app:popUpTo="@id/login_fragment"
            app:popUpToInclusive="true" />

        <argument
            android:name="email"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/login_email_fragment"
        android:name="com.example.ui.auth.loginEmail.LoginEmailFragment"
        android:label="Login email">

        <action
            android:id="@+id/login_email_to_register_action"
            app:destination="@id/register_fragment" />

        <action
            android:id="@+id/login_email_to_welcome_action"
            app:destination="@id/welcome_fragment"
            app:popUpTo="@id/login_email_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/register_fragment"
        android:name="com.example.ui.auth.register.RegisterFragment"
        android:label="Register">

        <action
            android:id="@+id/register_to_welcome_action"
            app:destination="@id/welcome_fragment"
            app:popUpTo="@id/register_fragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/welcome_fragment"
        android:name="com.example.ui.auth.welcome.WelcomeFragment"
        android:label="Welcome">

        <action
            android:id="@+id/welcome_to_main"
            app:destination="@id/main_navigation"
            app:launchSingleTop="true"
            app:popUpTo="@id/welcome_fragment"
            app:popUpToInclusive="true" />

    </fragment>

    <include app:graph="@navigation/main_navigation" />
</navigation>