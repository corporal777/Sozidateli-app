<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_tabs_navigation"
    app:startDestination="@id/my_schedule_fragment">

    <keep_state_fragment_back_stack
        android:id="@+id/my_schedule_fragment"
        android:name="com.example.ui.event.schedule.my.EventMyScheduleFragment"
        tools:layout="@layout/fragment_event_schedule" />

    <keep_state_fragment_back_stack
        android:id="@+id/schedule_fragment"
        android:name="com.example.ui.event.schedule.complete.EventCompleteScheduleFragment"
        tools:layout="@layout/fragment_event_schedule" />

    <keep_state_fragment_back_stack
        android:id="@+id/map_tabs_fragment"
        android:name="com.example.ui.mapTabs.MapTabsFragment"
        tools:layout="@layout/fragment_map_tabs" />

    <include app:graph="@navigation/about_event_navigation_state" />

</navigation>