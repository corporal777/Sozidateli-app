<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/splash_fragment">

    <fragment
        android:id="@+id/splash_fragment"
        android:name="com.example.ui.splash.SplashFragment"
        tools:layout="@layout/fragment_splash" />

    <fragment
        android:id="@+id/authorization_fragment"
        android:name="com.example.ui.auth.authorization.AuthorizationFragment"
        android:label="Login">

        <action
            android:id="@+id/login_to_login_email_action"
            app:destination="@id/login_fragment" />
        <action
            android:id="@+id/authorization_fragment_to_register_email_fragment"
            app:destination="@id/register_email_fragment" />
        <action
            android:id="@+id/authorization_fragment_to_register_sn_fragment"
            app:destination="@id/register_sn_fragment" />
    </fragment>

    <fragment
        android:id="@+id/login_fragment"
        android:name="com.example.ui.auth.login.LoginFragment"
        android:label="Login email">

        <action
            android:id="@+id/login_to_register_email_action"
            app:destination="@id/register_email_fragment"
            app:popUpTo="@id/authorization_fragment" />

        <action
            android:id="@+id/login_to_register_sn_action"
            app:destination="@id/register_sn_fragment"
            app:popUpTo="@id/authorization_fragment" />

        <action
            android:id="@+id/login_to_recovery_action"
            app:destination="@id/recovery_password_fragment" />
    </fragment>

    <fragment
        android:id="@+id/recovery_password_fragment"
        android:name="com.example.ui.auth.recoveryPassword.RecoveryPasswordFragment"
        android:label="@string/recovery_password_title">

        <action
            android:id="@+id/recovery_password_to_email_login"
            app:destination="@id/login_fragment"
            app:popUpTo="@id/login_fragment"
            app:popUpToInclusive="true" />

        <argument
            android:name="email"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/register_email_fragment"
        android:name="com.example.ui.auth.register.email.RegisterEmailFragment"
        android:label="Register">

        <action
            android:id="@+id/email_register_to_email_confirm"
            app:destination="@id/email_confirm_fragment"
            app:popUpTo="@id/authorization_fragment" />

        <action
            android:id="@+id/email_register_to_sn_register"
            app:destination="@id/register_sn_fragment"
            app:popUpTo="@id/authorization_fragment" />
    </fragment>

    <fragment
        android:id="@+id/register_sn_fragment"
        android:name="com.example.ui.auth.register.sn.RegisterSnFragment"
        android:label="Register">

        <argument
            android:name="snUser"
            app:argType="com.example.data.models.SnUser"
            app:nullable="false" />

        <action
            android:id="@+id/sn_register_to_email_confirm"
            app:destination="@id/email_confirm_fragment"
            app:popUpTo="@id/register_sn_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/email_confirm_fragment"
        android:name="com.example.ui.auth.confirm.EmailConfirmFragment">

        <argument
            android:name="email"
            app:argType="string" />

        <argument
            android:name="password"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="SnUser"
            app:argType="com.example.data.models.SnUser"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/welcome_fragment"
        android:name="com.example.ui.auth.welcome.WelcomeFragment"
        android:label="Welcome" />

    <fragment
        android:id="@+id/recommendations_fragment"
        android:name="com.example.ui.event.list.recommendations.RecommendationsFragment">

        <action
            android:id="@+id/recommendations_fragment_to_search_fragment"
            app:destination="@id/search_tabs_fragment" />

        <action
            android:id="@+id/recommendations_fragment_to_favorite_organizations_fragment"
            app:destination="@id/organizations_fragment" />

        <action
            android:id="@+id/recommendations_fragment_to_my_events_fragment"
            app:destination="@id/my_events_fragment" />

        <action
            android:id="@+id/recommendations_fragment_to_chat_list_tabs_fragment"
            app:destination="@id/chat_list_tabs_fragment" />

        <action
            android:id="@+id/recommendations_fragment_to_profile_fragment"
            app:destination="@id/profile_fragment" />
    </fragment>

    <fragment
        android:id="@+id/organizations_fragment"
        android:name="com.example.ui.organizations.list.OrganizationsFragment">

        <argument
            android:name="filter"
            app:argType="com.example.data.models.OrganizationsFilter"
            app:nullable="false" />

        <action
            android:id="@+id/organizations_fragment_to_self"
            app:destination="@id/organizations_fragment" />
    </fragment>

    <fragment
        android:id="@+id/my_events_fragment"
        android:name="com.example.ui.event.list.my.MyEventsFragment">

        <argument
            android:name="filter"
            app:argType="com.example.data.models.MyEventsFilter"
            app:nullable="false" />

        <action
            android:id="@+id/my_events_fragment_to_self"
            app:destination="@id/my_events_fragment" />
    </fragment>

    <fragment
        android:id="@+id/request_fragment"
        android:name="com.example.ui.event.registration.EventRegistrationFragment"
        tools:layout="@layout/fragment_request">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/event_rating_fragment"
        android:name="com.example.ui.event.rating.EventRatingFragment"
        tools:layout="@layout/fragment_event_rating">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/event_tabs_fragment"
        android:name="com.example.ui.eventTabs.EventTabsFragment"
        tools:layout="@layout/fragment_event_tabs">

        <action
            android:id="@+id/action_event_tabs_fragment_to_chat_list_tabs_fragment"
            app:destination="@id/chat_list_tabs_fragment" />
        <action
            android:id="@+id/main_to_search"
            app:destination="@id/search_tabs_fragment" />
        <action
            android:id="@+id/main_to_profile"
            app:destination="@id/profile_fragment" />
        <action
            android:id="@id/action_about_event_fragment_to_documents_list_fragment"
            app:destination="@id/documents_list_fragment" />
        <action
            android:id="@id/action_about_event_fragment_to_speakers_list_fragment"
            app:destination="@id/speakers_list_fragment" />
        <action
            android:id="@id/action_about_event_fragment_to_partner_fragment"
            app:destination="@id/partner_fragment" />
        <action
            android:id="@id/action_about_event_fragment_to_page_fragment"
            app:destination="@id/page_fragment" />
        <action
            android:id="@id/action_about_event_fragment_to_contacts_fragment"
            app:destination="@id/contacts_fragment" />
    </fragment>

    <activity
        android:id="@+id/image_view_activity"
        android:name="com.example.ui.image.ImageViewActivity"
        tools:layout="@layout/activity_image_view">

        <argument
            android:name="url"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="resource"
            app:argType="java.lang.Integer"
            app:nullable="true" />

        <argument
            android:name="bitmap"
            app:argType="android.graphics.Bitmap"
            app:nullable="true" />

        <argument
            android:name="transition_name"
            app:argType="string"
            app:nullable="true" />
    </activity>

    <fragment
        android:id="@+id/subevent_fragment"
        android:name="com.example.ui.subevent.SubeventFragment">
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="eventId"
            app:argType="string" />
        <argument
            android:name="subeventId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/subevent_user_list_fragment"
        android:name="com.example.ui.subevent.users.SubeventUserListFragment">
        <argument
            android:name="eventId"
            app:argType="string" />
        <argument
            android:name="subeventId"
            app:argType="string" />

        <action
            android:id="@+id/subevent_user_list_fragment_to_chat"
            app:destination="@id/chat_fragment" />
    </fragment>

    <fragment
        android:id="@+id/profile_fragment"
        android:name="com.example.ui.profile.ProfileFragment"
        android:label="@string/profile_title">
        <action
            android:id="@+id/profile_to_my_events"
            app:destination="@+id/my_events_fragment" />

        <action
            android:id="@+id/profile_to_about"
            app:destination="@+id/about_fragment" />

        <action
            android:id="@+id/profile_to_user"
            app:destination="@+id/user_fragment" />

        <action
            android:id="@+id/profile_to_favorite"
            app:destination="@+id/favorite_fragment" />

        <action
            android:id="@+id/action_profile_fragment_to_notifications_fragment"
            app:destination="@id/notifications_fragment" />

        <action
            android:id="@+id/action_profile_fragment_to_banned_fragment"
            app:destination="@id/banned_fragment" />
    </fragment>

    <fragment
        android:id="@+id/about_fragment"
        android:name="com.example.ui.about.AboutFragment"
        android:label=" " />

    <fragment
        android:id="@+id/favorite_fragment"
        android:name="com.example.ui.profile.favoritesTab.FavoriteTabsFragment"
        android:label="@string/profile_favorite" />

    <fragment
        android:id="@+id/organization_fragment"
        android:name="com.example.ui.organizations.OrganizationFragment">
        <argument
            android:name="organizationId"
            app:argType="string"
            app:nullable="false" />

        <action
            android:id="@+id/organization_to_organization_events"
            app:destination="@id/organization_events_fragment" />

        <action
            android:id="@+id/organization_to_organization_users"
            app:destination="@id/organization_members_fragment" />

        <action
            android:id="@+id/organization_to_user"
            app:destination="@id/user_fragment" />
    </fragment>

    <fragment
        android:id="@+id/organization_events_fragment"
        android:name="com.example.ui.organizations.events.OrganizationEventsFragment">
        <argument
            android:name="organizationId"
            app:argType="string"
            app:nullable="false" />
    </fragment>

    <fragment
        android:id="@+id/organization_members_fragment"
        android:name="com.example.ui.organizations.members.OrganizationMembersFragment">
        <argument
            android:name="organizationId"
            app:argType="string"
            app:nullable="false" />

        <action
            android:id="@+id/organization_members_to_user"
            app:destination="@id/user_fragment" />
    </fragment>

    <fragment
        android:id="@+id/notifications_fragment"
        android:name="com.example.ui.notification.center.NotificationsFragment"
        android:label="@string/notifications_label">

        <action
            android:id="@+id/notifications_center_to_notification"
            app:destination="@id/notification_fragment" />

        <action
            android:id="@+id/notifications_center_to_event_rating"
            app:destination="@id/event_rating_fragment" />
    </fragment>

    <fragment
        android:id="@+id/notification_fragment"
        android:name="com.example.ui.notification.NotificationFragment">

        <argument
            android:name="notification"
            app:argType="com.example.data.models.Notification"
            app:nullable="false" />

        <argument
            android:name="showButtons"
            android:defaultValue="true"
            app:argType="boolean" />

        <action
            android:id="@+id/notification_to_event_rating"
            app:destination="@id/event_rating_fragment" />
    </fragment>

    <fragment
        android:id="@+id/banned_fragment"
        android:name="com.example.ui.banned.BannedFragment"
        android:label="@string/profile_banned">

        <action
            android:id="@+id/banned_fragment_to_user_fragment"
            app:destination="@id/user_fragment" />
    </fragment>

    <fragment
        android:id="@+id/chat_list_tabs_fragment"
        android:name="com.example.ui.chatList.ChatListTabsFragment"
        android:label="@string/chat_list"
        tools:layout="@layout/fragment_chat_list">
        <action
            android:id="@+id/chat_list_to_chat"
            app:destination="@id/chat_fragment" />
        <action
            android:id="@+id/action_chat_list_fragment_to_contacts_search_fragment"
            app:destination="@id/contacts_search_fragment" />
    </fragment>

    <fragment
        android:id="@+id/chat_fragment"
        android:name="com.example.ui.chat.ChatFragment"
        android:label="{label}"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="label"
            app:argType="string" />
        <argument
            android:name="chatId"
            app:argType="string" />
        <argument
            android:name="userAvatar"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_chat_fragment_to_user_fragment"
            app:destination="@id/user_fragment"
            app:enterAnim="@anim/profile_enter"
            app:exitAnim="@anim/profile_exit"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/profile_popup_enter"
            app:popExitAnim="@anim/profile_popup_exit" />
    </fragment>

    <fragment
        android:id="@+id/contacts_search_fragment"
        android:name="com.example.ui.contactsSearch.ContactsSearchFragment"
        android:label="@string/contact_search_title"
        tools:layout="@layout/fragment_contacts_search">
        <action
            android:id="@+id/open_user"
            app:destination="@id/user_fragment" />
        <argument
            android:name="searchAction"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/user_fragment"
        android:name="com.example.ui.user.UserFragment"
        tools:layout="@layout/fragment_user">
        <action
            android:id="@+id/user_to_chat"
            app:destination="@id/chat_fragment"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/user_to_status"
            app:destination="@id/user_status_fragment" />
        <action
            android:id="@+id/user_to_edit"
            app:destination="@id/user_edit_fragment" />
        <action
            android:id="@+id/user_to_organization"
            app:destination="@id/organization_fragment" />
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/user_edit_fragment"
        android:name="com.example.ui.user.edit.UserEditFragment"
        tools:layout="@layout/fragment_user">
        <argument
            android:name="type"
            app:argType="com.example.data.models.UserEditDataType" />
        <action
            android:id="@+id/edit_to_edit"
            app:destination="@id/user_edit_fragment" />
    </fragment>

    <fragment
        android:id="@+id/user_status_fragment"
        android:name="com.example.ui.status.tabs.StatusPagesFragment"
        tools:layout="@layout/fragment_status_pages" />

    <fragment
        android:id="@+id/search_tabs_fragment"
        android:name="com.example.ui.search.tabs.SearchTabsFragment"
        tools:layout="@layout/fragment_search_tabs">
        <action
            android:id="@+id/search_tabs_to_qr_scanner"
            app:destination="@id/qr_scanner_fragment" />
    </fragment>

    <fragment
        android:id="@+id/qr_scanner_fragment"
        android:name="com.example.ui.search.qr.QrScannerFragment"
        tools:layout="@layout/fragment_qr_scanner">

        <action
            android:id="@+id/qr_scanner_to_enter_code"
            app:destination="@id/enter_event_code_fragment" />
    </fragment>

    <fragment
        android:id="@+id/enter_event_code_fragment"
        android:name="com.example.ui.search.code.EnterCodeFragment"
        tools:layout="@layout/fragment_enter_code" />

    <fragment
        android:id="@+id/stories_fragment"
        android:name="com.example.ui.stories.StoriesFragment" />

    <fragment
        android:id="@+id/about_event_fragment"
        android:name="com.example.ui.event.about.AboutEventFragment"
        tools:layout="@layout/fragment_about_event">
        <argument
            android:name="eventId"
            app:argType="string"
            app:nullable="false" />
        <action
            android:id="@+id/action_about_event_fragment_to_documents_list_fragment"
            app:destination="@id/documents_list_fragment" />
        <action
            android:id="@+id/action_about_event_fragment_to_speakers_list_fragment"
            app:destination="@id/speakers_list_fragment" />
        <action
            android:id="@+id/action_about_event_fragment_to_partner_fragment"
            app:destination="@id/partner_fragment" />
        <action
            android:id="@+id/action_about_event_fragment_to_page_fragment"
            app:destination="@id/page_fragment" />
        <action
            android:id="@+id/action_about_event_fragment_to_contacts_fragment"
            app:destination="@id/contacts_fragment" />
    </fragment>

    <fragment
        android:id="@+id/documents_list_fragment"
        android:name="com.example.ui.documents.DocumentsListFragment">
        <argument
            android:name="eventId"
            app:argType="string" />

        <argument
            android:name="pageId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/speakers_list_fragment"
        android:name="com.example.ui.event.speakers.EventSpeakersFragment"
        android:label="@string/speakers">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/partner_fragment"
        android:name="com.example.ui.partner.PartnerFragment"
        android:label="@string/partners_label"
        tools:layout="@layout/fragment_partner">

        <argument
            android:name="eventId"
            app:argType="string" />

        <argument
            android:name="partnerId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/page_fragment"
        android:name="com.example.ui.page.PageFragment">

        <argument
            android:name="eventId"
            app:argType="string" />

        <argument
            android:name="pageId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/agreement_fragment"
        android:name="com.example.ui.agreement.UserAgreementFragment" />

    <fragment
        android:id="@+id/contacts_fragment"
        android:name="com.example.ui.event.contacts.EventContactsFragment">

        <argument
            android:name="eventName"
            app:argType="string" />

        <argument
            android:name="phones"
            app:argType="com.example.data.models.PhoneAffiliation[]" />

        <argument
            android:name="emails"
            app:argType="com.example.data.models.EmailAffiliation[]" />

        <argument
            android:name="webLinks"
            app:argType="string[]" />

        <argument
            android:name="socialLinks"
            app:argType="string[]" />

        <argument
            android:name="address"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="mapInfo"
            app:argType="com.example.data.models.MapInfo"
            app:nullable="true" />

        <argument
            android:name="places"
            app:argType="com.example.data.models.Place[]"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/event_location_fragment"
        android:name="com.example.ui.event.location.EventLocationFragment">

        <argument
            android:name="eventName"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="mapInfo"
            app:argType="com.example.data.models.MapInfo"
            app:nullable="true" />

        <argument
            android:name="places"
            app:argType="com.example.data.models.Place[]"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/event_tags_fragment"
        android:name="com.example.ui.tags.TagsFragment" />
</navigation>