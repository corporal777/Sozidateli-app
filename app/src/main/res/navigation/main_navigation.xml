<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/events_tabs_fragment">

    <fragment
        android:id="@+id/events_tabs_fragment"
        android:name="com.example.ui.eventsTabs.EventsTabsFragment"
        android:label="@string/events_tabs_title"
        tools:layout="@layout/fragment_events_tabs">
        <action
            android:id="@+id/action_events_tabs_fragment_to_chat_navigation"
            app:destination="@id/chat_navigation" />
        <action
            android:id="@+id/action_events_tabs_fragment_to_about_event_navigation"
            app:destination="@id/about_event_navigation" />
        <action
            android:id="@+id/main_to_profile"
            app:destination="@id/profile_navigation" />
        <action
            android:id="@+id/action_events_tabs_fragment_to_request_fragment"
            app:destination="@id/request_fragment" />

        <action
            android:id="@+id/main_to_search"
            app:destination="@id/search_navigation" />
    </fragment>
    <include app:graph="@navigation/chat_navigation" />
    <include app:graph="@navigation/about_event_navigation" />
    <include app:graph="@navigation/profile_navigation" />
    <include app:graph="@navigation/search_navigation" />

    <fragment
        android:id="@+id/request_fragment"
        android:name="com.example.ui.request.RequestFragment"
        tools:layout="@layout/fragment_request">
        <argument
            android:name="event"
            app:argType="com.example.data.models.Event" />
    </fragment>

    <fragment
        android:id="@+id/event_tabs_fragment"
        android:name="com.example.ui.eventTabs.EventTabsFragment"
        tools:layout="@layout/fragment_event_tabs">
        <argument
            android:name="event"
            app:argType="com.example.data.models.Event" />
    </fragment>

    <fragment
        android:id="@+id/image_view_fragment"
        android:name="com.example.ui.image.ImageViewFragment"
        tools:layout="@layout/fragment_image_view">

        <argument
            android:name="url"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="resource"
            app:argType="java.lang.Integer"
            app:nullable="true" />

        <argument
            android:name="bitmap"
            app:argType="android.graphics.Bitmap"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/subevent_fragment"
        android:name="com.example.ui.mySchedule.subevent.SubeventFragment">
        <argument
            android:name="subevent"
            app:argType="com.example.data.models.Subevent" />
    </fragment>

    <fragment
        android:id="@+id/speaker_fragment"
        android:name="com.example.ui.speaker.SpeakerFragment">
        <argument
            android:name="user"
            app:argType="com.example.data.models.User" />
    </fragment>
</navigation>