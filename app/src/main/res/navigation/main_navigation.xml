<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/splash_fragment">

    <fragment
        android:id="@+id/splash_fragment"
        android:name="com.example.ui.splash.SplashFragment"
        tools:layout="@layout/fragment_splash" />

    <fragment
        android:id="@+id/login_fragment"
        android:name="com.example.ui.auth.login.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/login_to_login_email_action"
            app:destination="@id/login_email_fragment" />
    </fragment>

    <fragment
        android:id="@+id/login_email_fragment"
        android:name="com.example.ui.auth.loginEmail.LoginEmailFragment"
        android:label="Login email">

        <action
            android:id="@+id/login_email_to_register_action"
            app:destination="@id/register_fragment" />

        <action
            android:id="@+id/login_email_to_recovery_action"
            app:destination="@id/recovery_password_fragment" />

        <argument
            android:name="email"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="password"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="confirm"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/recovery_password_fragment"
        android:name="com.example.ui.auth.recoveryPassword.RecoveryPasswordFragment"
        android:label="@string/recovery_password_title">

        <argument
            android:name="email"
            app:argType="string"
            app:nullable="true"/>
    </fragment>

    <fragment
        android:id="@+id/register_fragment"
        android:name="com.example.ui.auth.register.RegisterFragment"
        android:label="Register">

        <action
            android:id="@+id/email_register_to_email_login"
            app:destination="@id/login_email_fragment"
            app:popUpTo="@id/login_email_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/welcome_fragment"
        android:name="com.example.ui.auth.welcome.WelcomeFragment"
        android:label="Welcome" />

    <fragment
        android:id="@+id/event_list_fragment"
        android:name="com.example.ui.eventsTabs.EventListFragment"
        android:label="@string/events_tabs_title"
        tools:layout="@layout/fragment_events_tabs">
        <action
            android:id="@+id/action_events_tabs_fragment_to_about_event_navigation"
            app:destination="@id/about_event_navigation" />
        <action
            android:id="@+id/action_events_tabs_fragment_to_request_fragment"
            app:destination="@id/request_fragment" />
        <action
            android:id="@+id/action_events_tabs_fragment_to_chat_navigation"
            app:destination="@id/chat_navigation" />
        <action
            android:id="@+id/main_to_search"
            app:destination="@id/search_navigation" />
        <action
            android:id="@+id/main_to_profile"
            app:destination="@id/profile_navigation" />
    </fragment>
    <include app:graph="@navigation/chat_navigation" />
    <include app:graph="@navigation/about_event_navigation" />
    <include app:graph="@navigation/profile_navigation" />
    <include app:graph="@navigation/search_navigation" />

    <fragment
        android:id="@+id/request_fragment"
        android:name="com.example.ui.request.RequestFragment"
        tools:layout="@layout/fragment_request">
        <argument
            android:name="event"
            app:argType="com.example.data.models.Event" />
    </fragment>

    <fragment
        android:id="@+id/event_tabs_fragment"
        android:name="com.example.ui.eventTabs.EventTabsFragment"
        tools:layout="@layout/fragment_event_tabs">

        <action
            android:id="@+id/action_event_tabs_fragment_to_chat_navigation"
            app:destination="@id/chat_navigation" />
        <action
            android:id="@+id/main_to_search"
            app:destination="@id/search_navigation" />
        <action
            android:id="@+id/main_to_profile"
            app:destination="@id/profile_navigation" />

    </fragment>

    <fragment
        android:id="@+id/image_view_fragment"
        android:name="com.example.ui.image.ImageViewFragment"
        tools:layout="@layout/fragment_image_view">

        <argument
            android:name="url"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="resource"
            app:argType="java.lang.Integer"
            app:nullable="true" />

        <argument
            android:name="bitmap"
            app:argType="android.graphics.Bitmap"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/subevent_fragment"
        android:name="com.example.ui.mySchedule.subevent.SubeventFragment">
        <argument
            android:name="subevent"
            app:argType="com.example.data.models.Subevent" />
        <action
            android:id="@+id/subevent_to_user_list"
            app:destination="@id/subevent_users_list_fragment" />
    </fragment>

    <fragment
        android:id="@+id/speaker_fragment"
        android:name="com.example.ui.speaker.SpeakerFragment">
        <argument
            android:name="user"
            app:argType="com.example.data.models.user.User" />
    </fragment>

    <fragment
        android:id="@+id/subevent_users_list_fragment"
        android:name="com.example.ui.mySchedule.usersList.UserListFragment">
        <argument android:name="subevent_id" />
    </fragment>

    <fragment
        android:id="@+id/chat_fragment"
        android:name="com.example.ui.chat.ChatFragment"
        android:label="{label}"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="label"
            app:argType="string" />
        <argument
            android:name="chatId"
            app:argType="string" />
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>
</navigation>