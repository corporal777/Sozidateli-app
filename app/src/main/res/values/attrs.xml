<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="viewBackground" format="reference" />

    <declare-styleable name="food">
        <attr name="password_hint_state_correct" format="boolean" />
        <attr name="password_hint_state_incorrect" format="boolean" />
    </declare-styleable>

    <declare-styleable name="AutoPlaceholderRecyclerView">
        <attr name="placeholder" format="reference" />
        <attr name="hideOnEmpty" format="boolean" />
    </declare-styleable>

    <declare-styleable name="UserSubscribeButton">
        <attr name="subscribeAction">
            <enum name="unblock" value="-1"/>
            <enum name="subscribe" value="0"/>
            <enum name="unsubscribe" value="1"/>
        </attr>
    </declare-styleable>
</resources>