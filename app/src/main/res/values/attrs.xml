<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="viewBackground" format="reference" />

    <declare-styleable name="CustomCircleLoadingButton">
        <attr name="circleButtonDrawable" format="reference" />
        <attr name="circleButtonText" format="string" />
    </declare-styleable>

    <declare-styleable name="CustomTextMenuView">
        <attr name="inputTitleText" format="string" />
        <attr name="inputHintText" format="string" />
        <attr name="inputMenuTextColor" format="reference" />
        <attr name="inputIconDrawable" format="reference" />
        <attr name="inputIconMode">
            <enum name="custom" value="-1"/>
            <enum name="none" value="0"/>
            <enum name="dropdown_menu" value="3"/>
        </attr>
        <attr name="inputHasCheckBox" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CustomPhoneTextInputView">
        <attr name="phoneTitleText" format="string" />
        <attr name="phoneHintText" format="string" />
        <attr name="phoneTextIcon" format="reference" />
        <attr name="phoneInputEnabled" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CustomTextInputView">
        <attr name="titleText" format="string" />
        <attr name="hintText" format="string" />
        <attr name="inputType">
            <flag name="none" value="0x00000000" />
            <flag name="text" value="0x00000001" />
            <flag name="textCapCharacters" value="0x00001001" />
            <flag name="textCapWords" value="0x00002001" />
            <flag name="textCapSentences" value="0x00004001" />
            <flag name="textMultiLine" value="0x00020001" />
            <flag name="textNoSuggestions" value="0x00080001" />
            <flag name="textEmailAddress" value="0x00000021" />
            <flag name="textPassword" value="0x00000081" />
            <flag name="number" value="0x00000002" />
            <flag name="phone" value="0x00000003" />
        </attr>
        <attr name="inputMaxLines" format="integer" />
        <attr name="inputMinLines" format="integer" />
        <attr name="inputEnabled" format="boolean" />
        <attr name="inputTextColor" format="reference" />
        <attr name="inputCheckBoxVisible" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CustomCheckView">
        <attr name="checkViewText" format="string" />
        <attr name="isCheckable" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CodeConfirmationView">
        <attr name="codeViewTextSize" format="dimension"/>
        <attr name="codeViewHeight" format="dimension" />
        <attr name="codeViewWidth" format="dimension" />
        <attr name="codeViewSpace" format="dimension" />
        <attr name="codeViewLength" format="integer" />
    </declare-styleable>

    <declare-styleable name="CustomLoadingButton">
        <attr name="buttonBackground" format="reference" />
        <attr name="buttonTextColor" format="reference" />
        <attr name="buttonMinHeight" format="dimension"/>
        <attr name="buttonTextSize" format="dimension" />
        <attr name="buttonText" format="string" />
        <attr name="buttonDrawable" format="reference" />
    </declare-styleable>

    <declare-styleable name="UserSubscribeButton">
        <attr name="subscribeAction">
            <enum name="subscribe" value="0" />
            <enum name="unsubscribe" value="1" />
            <enum name="favorite" value="2" />
            <enum name="unfavorite" value="3" />
            <enum name="unblock" value="4" />
        </attr>
        <attr name="showText" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ExpandableTextView">
        <attr name="limitedMaxLines" format="integer" />
        <attr name="originalText" format="string" />
        <attr name="expandAction" format="string" />
        <attr name="expandActionColor" format="string" />
    </declare-styleable>

    <declare-styleable name="food">
        <attr name="password_hint_state_correct" format="boolean" />
        <attr name="password_hint_state_incorrect" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CropImageView">
        <attr name="scv_img_src" format="reference" />
        <attr name="scv_crop_mode">
            <enum name="fit_image" value="0"/>
            <enum name="ratio_4_3" value="1"/>
            <enum name="ratio_3_4" value="2"/>
            <enum name="square" value="3"/>
            <enum name="ratio_16_9" value="4"/>
            <enum name="ratio_9_16" value="5"/>
            <enum name="free" value="6"/>
            <enum name="custom" value="7"/>
            <enum name="circle" value="8"/>
            <enum name="circle_square" value="9"/>
        </attr>
        <attr format="reference|color" name="scv_background_color"/>
        <attr format="reference|color" name="scv_overlay_color"/>
        <attr format="reference|color" name="scv_frame_color"/>
        <attr format="reference|color" name="scv_handle_color"/>
        <attr format="reference|color" name="scv_guide_color"/>
        <attr name="scv_guide_show_mode">
            <enum name="show_always" value="1"/>
            <enum name="show_on_touch" value="2"/>
            <enum name="not_show" value="3"/>
        </attr>
        <attr name="scv_handle_show_mode">
            <enum name="show_always" value="1"/>
            <enum name="show_on_touch" value="2"/>
            <enum name="not_show" value="3"/>
        </attr>
        <attr format="dimension" name="scv_handle_size"/>
        <attr format="dimension" name="scv_touch_padding"/>
        <attr format="dimension" name="scv_min_frame_size"/>
        <attr format="dimension" name="scv_frame_stroke_weight"/>
        <attr format="dimension" name="scv_guide_stroke_weight"/>
        <attr format="boolean" name="scv_crop_enabled"/>
        <attr format="float" name="scv_initial_frame_scale"/>
        <attr format="boolean" name="scv_animation_enabled"/>
        <attr format="integer" name="scv_animation_duration"/>
        <attr format="boolean" name="scv_handle_shadow_enabled"/>
    </declare-styleable>

    <declare-styleable name="CustomCropView">
        <attr name="guidelines">
            <enum name="on" value="2"/>
            <enum name="onTouch" value="1"/>
            <enum name="off" value="0"/>
        </attr>
        <attr name="fixAspectRatio" format="boolean"/>
        <attr name="aspectRatioX" format="integer"/>
        <attr name="aspectRatioY" format= "integer"/>
        <attr name="imageResource" format="reference"/>
    </declare-styleable>

</resources>