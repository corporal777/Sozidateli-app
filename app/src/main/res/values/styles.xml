<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="actionMenuTextColor">@color/colorAccent</item>
        <item name="android:listDivider">@drawable/divider</item>
        <item name="android:windowSharedElementsUseOverlay">false</item>
        <item name="android:windowReturnTransition">@android:transition/explode</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="android:timePickerDialogTheme">@style/AlertDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/AlertDialogTheme</item>
        <item name="android:windowBackground">@color/main_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:buttonBarNegativeButtonStyle">@style/AlertButtonStyle</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AlertButtonStyle</item>
        <item name="android:buttonBarButtonStyle">@style/AlertButtonStyle</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AlertButtonStyle</item>
        <item name="android:buttonStyle">@style/AlertButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertButtonStyle</item>
        <item name="buttonBarButtonStyle">@style/AlertButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertButtonStyle</item>
        <item name="buttonStyle">@style/AlertButtonStyle</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@android:color/transparent</item>
    </style>

    <style name="AlertButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="AppTheme.Tabs" parent="AppTheme">
        <item name="android:layout_height">64dp</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicatorColor">?attr/colorAccent</item>
        <item name="tabMaxWidth">0dp</item>
        <item name="tabMode">fixed</item>
        <item name="tabSelectedTextColor">@color/tab_text_selected</item>
        <item name="tabTextAppearance">@style/EventsTabText</item>
        <item name="tabTextColor">@color/tab_text</item>
        <item name="tabIndicatorFullWidth">false</item>
    </style>

    <style name="Auth.EditText" parent="Base.V7.Widget.AppCompat.EditText">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/background_input_borders</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">@color/hint_gray</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="FullScreenDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="EventsTabText" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="fontPath">fonts/OpenSans-Light.ttf</item>
    </style>

    <style name="ViewBackground" />

    <style name="ViewBackgroundPrimary">
        <item name="viewBackground">@color/colorPrimary</item>
    </style>

    <style name="ViewBackgroundAccent">
        <item name="viewBackground">@color/colorAccent</item>
    </style>

    <style name="ViewBackgroundTransparent">
        <item name="viewBackground">@android:color/transparent</item>
    </style>

    <style name="ViewBackgroundWhite">
        <item name="viewBackground">@android:color/white</item>
    </style>

    <style name="ViewBackgroundGray">
        <item name="viewBackground">@color/gray</item>
    </style>

    <style name="ViewBackgroundBlack">
        <item name="viewBackground">@color/text_title</item>
    </style>

    <style name="ViewBackgroundAttention">
        <item name="viewBackground">@color/attention_action</item>
    </style>

    <style name="ViewBackgroundSave">
        <item name="viewBackground">@color/button_save_background</item>
    </style>

    <style name="ViewBackgroundFacebook">
        <item name="viewBackground">@color/auth_fb_color</item>
    </style>

    <style name="ViewBackgroundVk">
        <item name="viewBackground">@color/auth_vk_color</item>
    </style>

    <style name="ViewBackgroundOk">
        <item name="viewBackground">@color/auth_ok_color</item>
    </style>

    <style name="ViewBackgroundStatusLow">
        <item name="viewBackground">@color/profile_status_low_background</item>
    </style>

    <style name="ViewBackgroundStatusMid">
        <item name="viewBackground">@color/profile_status_mid_background</item>
    </style>

    <style name="ViewBackgroundStatusMax">
        <item name="viewBackground">@color/profile_status_max_background</item>
    </style>

    <style name="InputBorder">
        <item name="viewBackground">@color/input_border</item>
    </style>

    <style name="ProfileFieldTextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ProfileInfoField">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingTop">@dimen/profile_full_padding_top</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="ProfileInfoField.Label">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="fontPath">fonts/OpenSans-Light.ttf</item>
    </style>

    <style name="ProfileInfoField.Text">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <style name="ViewDivider">
        <item name="android:background">@drawable/divider</item>
    </style>

    <style name="ViewDivider.Horizontal.Profile_Full" parent="ViewDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:paddingTop">10dp</item>
    </style>

    <style name="ViewDivider.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
    </style>

    <style name="ViewDivider.Vertical">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="ChatList" />

    <style name="ChatList.Empty">
        <item name="android:background">@color/main_background</item>
    </style>

    <style name="ChatList.Empty.Message">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ChatList.Empty.Button">
        <item name="android:background">@drawable/background_corners</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:theme">@style/ViewBackgroundAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">42dp</item>
    </style>

    <style name="Chat" />

    <style name="Chat.Input" />

    <style name="Chat.Input.Button">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="Toolbar" />

    <style name="Toolbar.Custom" />

    <style name="Toolbar.Custom.Title">
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/toolbar_title_text</item>
    </style>

    <style name="Toolbar.Custom.Button">
        <item name="android:layout_width">@dimen/toolbar_content_button_size</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Profile" />

    <style name="Profile.Title">
        <item name="android:textColor">@color/profile_title_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
    </style>

    <style name="Profile.Data">
        <item name="android:textColor">@color/profile_data_text</item>
        <item name="android:textColorLink">@color/profile_data_text_link</item>
        <item name="android:textSize">17sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
    </style>

    <style name="Profile.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/background_highlight</item>
        <item name="android:theme">@style/ViewBackgroundWhite</item>
        <item name="android:drawableEnd">@drawable/ic_keyboard_arrow_right</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">@dimen/margin_horizontal_default</item>
        <item name="android:paddingEnd">@dimen/margin_horizontal_default</item>
    </style>

    <style name="Profile.Edit" />

    <style name="Profile.Edit.ActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minEms">8</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Profile.Edit.InputContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
    </style>

    <style name="Profile.Edit.InputTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/profile_title_text</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Profile.Edit.InputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/input_border_color</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/attention_action</item>
    </style>

    <style name="Profile.Edit.InputLayout.DropDown">
        <item name="endIconDrawable">@drawable/ic_drop_down</item>
        <item name="endIconMode">dropdown_menu</item>
    </style>

    <style name="Profile.Edit.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_color_profile_data</item>
        <item name="android:theme">@style/Profile.Edit.Input.Theme</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:colorControlActivated">@color/colorAccent</item>
    </style>

    <style name="Profile.Edit.Input.SingleLine">
        <item name="android:maxLines">1</item>
    </style>

    <style name="Profile.Edit.Input.SingleLine.DropDown">
        <item name="android:cursorVisible">false</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Profile.Edit.Input.Theme">
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:colorControlActivated">@color/colorAccent</item>
    </style>

    <style name="Profile.Edit.Switch" parent="Profile.Edit.InputTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:colorControlActivated">#FFF</item>
    </style>

    <style name="Profile.Edit.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/ic_profile_edit</item>
        <item name="android:contentDescription">@string/content_description_edit</item>
    </style>

    <style name="UserItem" />

    <style name="UserItem.Avatar">
        <item name="android:layout_width">63dp</item>
        <item name="android:layout_height">63dp</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="UserItem.Name">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">3</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CheckBoxTheme">
        <item name="colorAccent">@color/badge_attention_low</item>
        <item name="android:colorControlNormal">@color/input_border_color</item>
    </style>

    <style name="Notification" />

    <style name="Notification.Date">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Notification.Title">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Notification.Message">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Notification.Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_default</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_default</item>
        <item name="android:textColor">@color/notification_accept_state_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Notification.ActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/background_button_underline</item>
    </style>

    <style name="Notification.ReadMore">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/background_corners</item>
        <item name="android:theme">@style/ViewBackgroundTransparent</item>
        <item name="android:drawableEnd">@drawable/ic_keyboard_arrow_right</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:text">@string/notifications_read_more</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Status" />

    <style name="Status.Description">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/profile_status_description</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Status.Description.Profile">
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="Status.Counter">
        <item name="android:layout_width">29dp</item>
        <item name="android:layout_height">29dp</item>
        <item name="android:textColor">@color/profile_status_description</item>
        <item name="android:textSize">16dp</item>
        <item name="android:background">@drawable/background_status_counter</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
